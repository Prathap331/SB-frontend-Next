              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "blur": {
                  "type": "number"
                },
                "offset_x": {
                  "type": "number"
                },
                "offset_y": {
                  "type": "number"
                }
