          },
          "icon": {
            "type": "string",
            "enum": [
              "pop",
              "spin_in",
              "bounce",
              "fade",
              "wipe",
              "none"
            ],
            "default": "pop",
            "description": "icon"
          },
          "value": {
            "type": "string",
            "enum": [
              "count_up",
              "count_up_pop",
              "rise",
              "fade_up",
              "scale_in",
              "blur_in",
              "none"
            ],
            "default": "count_up",
            "description": "the number"
          },
          "label": {
            "type": "string",
            "enum": [
              "rise",
              "fade_up",
              "fade",
              "blur_in",
              "scale_in",
              "slam",
              "slide_left",
              "slide_right",
              "none",
              "word_fade",
              "word_pop",
              "typewriter",
