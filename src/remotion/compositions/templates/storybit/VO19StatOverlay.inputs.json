            "description": "the card"
          }
        }
      },
      "cue_times": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maxItems": 2,
        "description": "Seconds from the template start when each element appears, in order: value, label. value → label. Compute as (spoken word time − beat start time) from WhisperX."
      },
      "elements": {
        "type": "object",
        "description": "Editor edits per element id (see element_manifest.json): position, style, visibility and animation.",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visible": {
              "type": "boolean"
            },
            "offset_x": {
              "type": "number"
