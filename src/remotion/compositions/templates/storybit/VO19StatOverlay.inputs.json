            "offset_y": {
              "type": "number"
            },
            "scale": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 4
            },
            "rotation": {
              "type": "number"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "z_index": {
              "type": "number"
            },
            "font_family": {
              "type": "string"
            },
            "font_weight": {
              "type": "number"
            },
