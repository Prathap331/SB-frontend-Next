                "entrance": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "none",
                        "fade",
                        "slide_up",
                        "slide_down",
                        "slide_left",
                        "slide_right",
                        "pop",
                        "zoom_in",
                        "blur_in",
                        "drop",
                        "spin_in"
                      ]
                    },
                    "start": {
                      "type": "number"
                    },
                    "duration": {
                      "type": "number"
                    },
                    "easing": {
                      "enum": [
                        "linear",
                        "ease_in",
                        "ease_out",
                        "ease_in_out",
                        "back_out"
                      ]
                    },
                    "distance": {
                      "type": "number"
                    }
                  }
                },
                "exit": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "none",
                        "fade",
                        "slide_up",
                        "slide_down",
                        "slide_left",
                        "slide_right",
                        "zoom_out",
                        "blur_out",
                        "shrink"
                      ]
                    },
                    "start": {
                      "type": "number"
                    },
                    "duration": {
                      "type": "number"
