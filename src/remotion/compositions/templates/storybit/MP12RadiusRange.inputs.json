{
  "template": "MP-12",
  "name": "Radius / Range",
  "animation_type": "mp_radius_range",
  "pick_when": "Showing how far something reaches from a place: missile range, delivery radius, flight range, impact zone.",
  "placement": "full",
  "frame": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 100,
    "safe_box": [
      1720,
      880
    ]
  },
  "duration": {
    "frames": [
      90,
      240
    ],
    "seconds": [
      3,
      8
    ],
    "default_frames": 180,
    "note": "Length comes from the voice beat (clock.durationInFrames), not from props."
  },
  "rules": [
    "Stay within every limit below; longer text is shortened at a word boundary, too-short or missing required fields are errors.",
    "Numbers are raw values (no commas, units or currency symbols) — the template formats and animates them.",
    "Only real, sourced facts, quotes and figures. Label invented example numbers as illustrative.",
    "Icons are Lucide names from the repository icon map; unknown names render as a circle."
  ],
  "inputs": [
    {
      "path": "lat",
      "type": "number",
      "required": true,
      "fills": "Latitude of the centre (north positive)",
      "limits": "number · ≥ -85 · ≤ 85",
      "example": 28.61
    },
    {
      "path": "lon",
      "type": "number",
      "required": true,
      "fills": "Longitude of the centre (east positive)",
      "limits": "number · ≥ -180 · ≤ 180",
      "example": 77.21
    },
    {
      "path": "title",
      "type": "text",
      "required": false,
      "fills": "Heading in the top-left corner",
      "limits": "3–44 chars · 1–8 words · longest word 18 · max 1 line",
      "example": "How far can it reach? (illustrative)"
    },
    {
      "path": "center_label",
      "type": "text",
      "required": true,
      "fills": "Label at the centre point",
      "limits": "2–28 chars · 1–5 words · longest word 18 · max 1 line",
      "hint": "\"New Delhi\".",
      "example": "New Delhi"
    },
    {
      "path": "highlight_country",
      "type": "text",
      "required": false,
      "fills": "Country filled in a soft accent",
      "limits": "2–40 chars · 1–6 words · longest word 20 · max 1 line",
      "hint": "Country name in English."
    },
    {
      "path": "rings[]",
      "type": "list",
      "required": true,
      "fills": "Distance rings, smallest first",
      "limits": "1–3 items"
    },
    {
      "path": "rings[].label",
      "type": "text",
      "required": false,
      "fills": "Label on the ring",
      "limits": "2–26 chars · 1–5 words · longest word 16 · max 1 line",
      "hint": "Default \"<radius> km\". E.g. \"Agni-I · 700 km\"."
    },
    {
      "path": "rings[].radius_km",
      "type": "number",
      "required": true,
      "fills": "Real distance from the centre in kilometres",
      "limits": "number · ≥ 1 · ≤ 15000"
    },
    {
      "path": "style.heading_font",
      "type": "choice",
      "required": false,
      "fills": "Font for bold text (weight ≥ 700: titles, numbers, headings)",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins"
    },
    {
      "path": "style.body_font",
      "type": "choice",
      "required": false,
      "fills": "Font for all other text",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins (or the heading font)"
    },
    {
      "path": "style.background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "style.background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "style.scrim_color",
      "type": "color",
      "required": false,
      "fills": "Dark overlay behind text on images and footage",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#080A1C"
    },
    {
      "path": "style.text_color",
      "type": "color",
      "required": false,
      "fills": "Main text (titles, labels, numbers)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#FFF6E6"
    },
    {
      "path": "style.muted_color",
      "type": "color",
      "required": false,
      "fills": "Secondary text (subtitles, descriptions, context)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#C9CDE8"
    },
    {
      "path": "style.accent_color",
      "type": "color",
      "required": false,
      "fills": "Accent lines, highlights, kicker, units",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F5A524"
    },
    {
      "path": "style.series_2_color",
      "type": "color",
      "required": false,
      "fills": "Second data series / slice (the first uses accent)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#22D3EE"
    },
    {
      "path": "style.series_3_color",
      "type": "color",
      "required": false,
      "fills": "Third data series / slice",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#A78BFA"
    },
    {
      "path": "background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid) — same as style.background_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour) — same as style.background_2_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "font_sizes.title",
      "type": "number",
      "required": false,
      "fills": "Font size of heading in the top-left corner (px, largest; shrinks only if it would not fit)",
      "limits": "36–52 px",
      "default": 52
    },
    {
      "path": "font_sizes.center_label",
      "type": "number",
      "required": false,
      "fills": "Font size of label at the centre point (px, largest; shrinks only if it would not fit)",
      "limits": "22–34 px",
      "default": 34
    },
    {
      "path": "font_sizes.rings.label",
      "type": "number",
      "required": false,
      "fills": "Font size of label on the ring (px, largest; shrinks only if it would not fit)",
      "limits": "18–26 px",
      "default": 26
    },
    {
      "path": "animations.map",
      "type": "animation",
      "required": false,
      "fills": "the map (first frames)",
      "values": [
        "fade",
        "blur_in",
        "wipe",
        "cut"
      ],
      "default": "fade",
      "hint": "fade: Fades in; blur_in: Sharpens from a blur; wipe: Revealed left to right; cut: No transition"
    },
    {
      "path": "animations.center",
      "type": "animation",
      "required": false,
      "fills": "centre point and its label",
      "values": [
        "pop",
        "spin_in",
        "bounce",
        "fade",
        "wipe",
        "none"
      ],
      "default": "pop",
      "hint": "pop: Pops in with a small overshoot; spin_in: Spins in a quarter turn while growing; bounce: Drops in and bounces; fade: Fades in; wipe: Revealed left to right; none: Appears instantly"
    },
    {
      "path": "animations.rings",
      "type": "animation",
      "required": false,
      "fills": "each ring (grows outwards)",
      "values": [
        "grow",
        "fade",
        "pop",
        "none"
      ],
      "default": "grow",
      "hint": "grow: Draws out from its start; fade: Fades in; pop: Pops in with a small overshoot; none: Appears instantly"
    },
    {
      "path": "animations.ring_labels",
      "type": "animation",
      "required": false,
      "fills": "label on each ring",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "pop",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.title",
      "type": "animation",
      "required": false,
      "fills": "heading",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "fade",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.exit",
      "type": "animation",
      "required": false,
      "fills": "pins, rings and labels",
      "values": [
        "fade_up",
        "fade",
        "slide_down",
        "scale_down",
        "cut"
      ],
      "default": "fade",
      "hint": "fade_up: Fades out while moving up; fade: Fades out; slide_down: Moves down while fading out; scale_down: Shrinks slightly while fading out; cut: Disappears instantly at the cut"
    },
    {
      "path": "cue_times",
      "type": "cues",
      "required": false,
      "fills": "When elements appear: centre → ring 1 → ring 2 → ring 3",
      "limits": "seconds from the template start, increasing; centre → ring 1 → ring 2 → ring 3 (when each distance is mentioned)."
    }
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MP-12 Radius / Range",
    "type": "object",
    "properties": {
      "lat": {
        "type": "number",
        "minimum": -85,
        "maximum": 85,
        "description": "Latitude of the centre (north positive). Raw number, no units or commas."
      },
      "lon": {
        "type": "number",
        "minimum": -180,
        "maximum": 180,
        "description": "Longitude of the centre (east positive). Raw number, no units or commas."
      },
      "title": {
        "type": "string",
        "minLength": 3,
        "maxLength": 44,
        "description": "Heading in the top-left corner. 1–8 words, longest word 18 letters."
      },
      "center_label": {
        "type": "string",
        "minLength": 2,
        "maxLength": 28,
        "description": "Label at the centre point. 1–5 words, longest word 18 letters. \"New Delhi\"."
      },
      "highlight_country": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40,
        "description": "Country filled in a soft accent. 1–6 words, longest word 20 letters. Country name in English."
      },
      "rings": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 2,
              "maxLength": 26,
              "description": "Label on the ring. 1–5 words, longest word 16 letters. Default \"<radius> km\". E.g. \"Agni-I · 700 km\"."
            },
            "radius_km": {
              "type": "number",
              "minimum": 1,
              "maximum": 15000,
              "description": "Real distance from the centre in kilometres. Raw number, no units or commas."
            }
          },
          "required": [
            "radius_km"
          ],
          "additionalProperties": false
        },
        "description": "Distance rings, smallest first"
      },
      "background_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background (gradient start, or solid) (same as style.background_color; wins over it)"
      },
      "background_2_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background gradient end (set equal to background for a solid colour) (same as style.background_2_color; wins over it)"
      },
      "style": {
        "type": "object",
        "additionalProperties": false,
        "description": "Fonts and colours. Omit any key to use the default.",
        "properties": {
          "heading_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
              "roboto_slab",
              "lora",
              "baloo_2",
              "mukta",
              "hind",
              "kalam"
            ],
            "default": "poppins",
            "description": "Font for weight ≥ 700 text"
          },
          "body_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
              "roboto_slab",
              "lora",
              "baloo_2",
              "mukta",
              "hind",
              "kalam"
            ],
            "description": "Font for other text"
          },
          "background_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Theme background (gradient start, or solid)",
            "default": "#141A45"
          },
          "background_2_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Theme background gradient end (set equal to background for a solid colour)",
            "default": "#0C1030"
          },
          "scrim_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Dark overlay behind text on images and footage",
            "default": "#080A1C"
          },
          "text_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Main text (titles, labels, numbers)",
            "default": "#FFF6E6"
          },
          "muted_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Secondary text (subtitles, descriptions, context)",
            "default": "#C9CDE8"
          },
          "accent_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Accent lines, highlights, kicker, units",
            "default": "#F5A524"
          },
          "series_2_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Second data series / slice (the first uses accent)",
            "default": "#22D3EE"
          },
          "series_3_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Third data series / slice",
            "default": "#A78BFA"
          }
        }
      },
      "font_sizes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Largest font size per element in px. The template still shrinks text that would not fit.",
        "properties": {
          "title": {
            "type": "number",
            "minimum": 36,
            "maximum": 52,
            "default": 52,
            "description": "Heading in the top-left corner"
          },
          "center_label": {
            "type": "number",
            "minimum": 22,
            "maximum": 34,
            "default": 34,
            "description": "Label at the centre point"
          },
          "rings.label": {
            "type": "number",
            "minimum": 18,
            "maximum": 26,
            "default": 26,
            "description": "Label on the ring"
          }
        }
      },
      "animations": {
        "type": "object",
        "additionalProperties": false,
        "description": "Animation preset per element. Omit a key to use its default.",
        "properties": {
          "map": {
            "type": "string",
            "enum": [
              "fade",
              "blur_in",
              "wipe",
              "cut"
            ],
            "default": "fade",
            "description": "the map (first frames)"
          },
          "center": {
            "type": "string",
            "enum": [
              "pop",
              "spin_in",
              "bounce",
              "fade",
              "wipe",
              "none"
            ],
            "default": "pop",
            "description": "centre point and its label"
          },
          "rings": {
            "type": "string",
            "enum": [
              "grow",
              "fade",
              "pop",
              "none"
            ],
            "default": "grow",
            "description": "each ring (grows outwards)"
          },
          "ring_labels": {
            "type": "string",
            "enum": [
              "pop",
              "slide_up",
              "slide_left",
              "fade",
              "none"
            ],
            "default": "pop",
            "description": "label on each ring"
          },
          "title": {
            "type": "string",
            "enum": [
              "rise",
              "fade_up",
              "fade",
              "blur_in",
              "scale_in",
              "slam",
              "slide_left",
              "slide_right",
              "none",
              "word_fade",
              "word_pop",
              "typewriter",
              "letter_rise"
            ],
            "default": "fade",
            "description": "heading"
          },
          "exit": {
            "type": "string",
            "enum": [
              "fade_up",
              "fade",
              "slide_down",
              "scale_down",
              "cut"
            ],
            "default": "fade",
            "description": "pins, rings and labels"
          }
        }
      },
      "cue_times": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maxItems": 4,
        "description": "Seconds from the template start when each element appears, in order: centre, ring 1, ring 2, ring 3. centre → ring 1 → ring 2 → ring 3 (when each distance is mentioned). Compute as (spoken word time − beat start time) from WhisperX."
      }
    },
    "required": [
      "lat",
      "lon",
      "center_label",
      "rings"
    ],
    "additionalProperties": false
  },
  "example": {
    "title": "How far can it reach? (illustrative)",
    "center_label": "New Delhi",
    "lat": 28.61,
    "lon": 77.21,
    "rings": [
      {
        "radius_km": 700
      },
      {
        "radius_km": 2000
      },
      {
        "radius_km": 3500
      }
    ],
    "highlight_country": "India"
  }
}
