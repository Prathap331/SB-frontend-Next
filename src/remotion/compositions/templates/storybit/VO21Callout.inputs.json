{
  "template": "VO-21",
  "name": "Callout / Annotation",
  "animation_type": "vo_callout",
  "pick_when": "Pointing out specific things in the footage or a photo: \"this is the control room\", \"note the crack here\".",
  "placement": "overlay",
  "frame": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 100,
    "safe_box": [
      1720,
      880
    ]
  },
  "duration": {
    "frames": [
      45,
      240
    ],
    "seconds": [
      1.5,
      8
    ],
    "default_frames": 120,
    "note": "Length comes from the voice beat (clock.durationInFrames), not from props."
  },
  "rules": [
    "Stay within every limit below; longer text is shortened at a word boundary, too-short or missing required fields are errors.",
    "Numbers are raw values (no commas, units or currency symbols) — the template formats and animates them.",
    "Only real, sourced facts, quotes and figures. Label invented example numbers as illustrative.",
    "Icons are Lucide names from the repository icon map; unknown names render as a circle."
  ],
  "inputs": [
    {
      "path": "callouts[]",
      "type": "list",
      "required": true,
      "fills": "Spots to point at, in the order they are mentioned",
      "limits": "1–5 items"
    },
    {
      "path": "callouts[].label",
      "type": "text",
      "required": true,
      "fills": "Callout label",
      "limits": "2–40 chars · 1–7 words · longest word 16 · max 2 lines",
      "hint": "What the spot is."
    },
    {
      "path": "callouts[].x",
      "type": "number",
      "required": true,
      "fills": "Horizontal position of the spot, % of the frame width (0 = left, 100 = right)",
      "limits": "number · ≥ 0 · ≤ 100"
    },
    {
      "path": "callouts[].y",
      "type": "number",
      "required": true,
      "fills": "Vertical position of the spot, % of the frame height (0 = top, 100 = bottom)",
      "limits": "number · ≥ 0 · ≤ 100"
    },
    {
      "path": "callouts[].icon",
      "type": "icon",
      "required": false,
      "fills": "Callout icon",
      "limits": "Lucide icon name",
      "fallback": "none"
    },
    {
      "path": "image_url",
      "type": "image",
      "required": false,
      "fills": "Photo to annotate (omit to annotate the footage underneath)",
      "limits": "https URL or asset URL"
    },
    {
      "path": "marker",
      "type": "choice",
      "required": false,
      "fills": "Filled dot, or a ring with a pulse",
      "values": [
        "dot",
        "ring"
      ],
      "default": "ring"
    },
    {
      "path": "look",
      "type": "choice",
      "required": false,
      "fills": "Dark pill, dark box, or accent-filled pill",
      "values": [
        "pill",
        "box",
        "accent"
      ],
      "default": "pill"
    },
    {
      "path": "style.heading_font",
      "type": "choice",
      "required": false,
      "fills": "Font for bold text (weight ≥ 700: titles, numbers, headings)",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins"
    },
    {
      "path": "style.body_font",
      "type": "choice",
      "required": false,
      "fills": "Font for all other text",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins (or the heading font)"
    },
    {
      "path": "style.background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "style.background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "style.scrim_color",
      "type": "color",
      "required": false,
      "fills": "Dark overlay behind text on images and footage",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#080A1C"
    },
    {
      "path": "style.text_color",
      "type": "color",
      "required": false,
      "fills": "Main text (titles, labels, numbers)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#FFF6E6"
    },
    {
      "path": "style.muted_color",
      "type": "color",
      "required": false,
      "fills": "Secondary text (subtitles, descriptions, context)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#C9CDE8"
    },
    {
      "path": "style.accent_color",
      "type": "color",
      "required": false,
      "fills": "Accent lines, highlights, kicker, units",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F5A524"
    },
    {
      "path": "style.card_color",
      "type": "color",
      "required": false,
      "fills": "Chip / card / step fill (default: translucent white, darker over footage)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.on_accent_color",
      "type": "color",
      "required": false,
      "fills": "Icons and numbers drawn on accent-filled shapes",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid) — same as style.background_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour) — same as style.background_2_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "font_sizes.callouts.label",
      "type": "number",
      "required": false,
      "fills": "Font size of callout label (px, largest; shrinks only if it would not fit)",
      "limits": "20–32 px",
      "default": 32
    },
    {
      "path": "animations.image_motion",
      "type": "animation",
      "required": false,
      "fills": "the image (when image_url is set)",
      "values": [
        "push_in",
        "pull_out",
        "pan_left",
        "pan_right",
        "drift",
        "static"
      ],
      "default": "static",
      "hint": "push_in: Slow zoom in (1.00 → 1.08); pull_out: Slow zoom out (1.08 → 1.00); pan_left: Slow pan towards the left; pan_right: Slow pan towards the right; drift: Slow zoom with a slight rotation; static: No movement"
    },
    {
      "path": "animations.markers",
      "type": "animation",
      "required": false,
      "fills": "marker on each spot",
      "values": [
        "pop",
        "spin_in",
        "bounce",
        "fade",
        "wipe",
        "none"
      ],
      "default": "pop",
      "hint": "pop: Pops in with a small overshoot; spin_in: Spins in a quarter turn while growing; bounce: Drops in and bounces; fade: Fades in; wipe: Revealed left to right; none: Appears instantly"
    },
    {
      "path": "animations.lines",
      "type": "animation",
      "required": false,
      "fills": "line from spot to label",
      "values": [
        "grow",
        "fade",
        "pop",
        "none"
      ],
      "default": "grow",
      "hint": "grow: Draws out from its start; fade: Fades in; pop: Pops in with a small overshoot; none: Appears instantly"
    },
    {
      "path": "animations.labels",
      "type": "animation",
      "required": false,
      "fills": "each label",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "pop",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.exit",
      "type": "animation",
      "required": false,
      "fills": "all callouts",
      "values": [
        "fade_up",
        "fade",
        "slide_down",
        "scale_down",
        "cut"
      ],
      "default": "fade",
      "hint": "fade_up: Fades out while moving up; fade: Fades out; slide_down: Moves down while fading out; scale_down: Shrinks slightly while fading out; cut: Disappears instantly at the cut"
    },
    {
      "path": "cue_times",
      "type": "cues",
      "required": false,
      "fills": "When elements appear: callout 1 → callout 2 → callout 3 → callout 4 → callout 5",
      "limits": "seconds from the template start, increasing; One cue per callout, when the narrator mentions it."
    }
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "VO-21 Callout / Annotation",
    "type": "object",
    "properties": {
      "callouts": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40,
              "description": "Callout label. 1–7 words, longest word 16 letters. What the spot is."
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Horizontal position of the spot, % of the frame width (0 = left, 100 = right). Raw number, no units or commas."
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Vertical position of the spot, % of the frame height (0 = top, 100 = bottom). Raw number, no units or commas."
            },
            "icon": {
              "type": "string",
              "description": "Lucide icon name (kebab-case). Optional; fallback none."
            }
          },
          "required": [
            "label",
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "description": "Spots to point at, in the order they are mentioned"
      },
      "image_url": {
        "type": "string",
        "format": "uri",
        "description": "Photo to annotate (omit to annotate the footage underneath)"
      },
      "marker": {
        "type": "string",
        "enum": [
          "dot",
          "ring"
        ],
        "default": "ring",
        "description": "Filled dot, or a ring with a pulse"
      },
      "look": {
        "type": "string",
        "enum": [
          "pill",
          "box",
          "accent"
        ],
        "default": "pill",
        "description": "Dark pill, dark box, or accent-filled pill"
      },
      "background_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background (gradient start, or solid) (same as style.background_color; wins over it)"
      },
      "background_2_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background gradient end (set equal to background for a solid colour) (same as style.background_2_color; wins over it)"
      },
      "style": {
        "type": "object",
        "additionalProperties": false,
        "description": "Fonts and colours. Omit any key to use the default.",
        "properties": {
          "heading_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
              "roboto_slab",
              "lora",
              "baloo_2",
              "mukta",
              "hind",
              "kalam"
            ],
            "default": "poppins",
            "description": "Font for weight ≥ 700 text"
          },
          "body_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
              "roboto_slab",
              "lora",
              "baloo_2",
              "mukta",
              "hind",
              "kalam"
            ],
            "description": "Font for other text"
          },
          "background_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Theme background (gradient start, or solid)",
            "default": "#141A45"
          },
          "background_2_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Theme background gradient end (set equal to background for a solid colour)",
            "default": "#0C1030"
          },
          "scrim_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Dark overlay behind text on images and footage",
            "default": "#080A1C"
          },
          "text_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Main text (titles, labels, numbers)",
            "default": "#FFF6E6"
          },
          "muted_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Secondary text (subtitles, descriptions, context)",
            "default": "#C9CDE8"
          },
          "accent_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Accent lines, highlights, kicker, units",
            "default": "#F5A524"
          },
          "card_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Chip / card / step fill (default: translucent white, darker over footage)"
          },
          "on_accent_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Icons and numbers drawn on accent-filled shapes",
            "default": "#141A45"
          }
        }
      },
      "font_sizes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Largest font size per element in px. The template still shrinks text that would not fit.",
        "properties": {
          "callouts.label": {
            "type": "number",
            "minimum": 20,
            "maximum": 32,
            "default": 32,
            "description": "Callout label"
          }
        }
      },
      "animations": {
        "type": "object",
        "additionalProperties": false,
        "description": "Animation preset per element. Omit a key to use its default.",
        "properties": {
          "image_motion": {
            "type": "string",
            "enum": [
              "push_in",
              "pull_out",
              "pan_left",
              "pan_right",
              "drift",
              "static"
            ],
            "default": "static",
            "description": "the image (when image_url is set)"
          },
          "markers": {
            "type": "string",
            "enum": [
              "pop",
              "spin_in",
              "bounce",
              "fade",
              "wipe",
              "none"
            ],
            "default": "pop",
            "description": "marker on each spot"
          },
          "lines": {
            "type": "string",
            "enum": [
              "grow",
              "fade",
              "pop",
              "none"
            ],
            "default": "grow",
            "description": "line from spot to label"
          },
          "labels": {
            "type": "string",
            "enum": [
              "pop",
              "slide_up",
              "slide_left",
              "fade",
              "none"
            ],
            "default": "pop",
            "description": "each label"
          },
          "exit": {
            "type": "string",
            "enum": [
              "fade_up",
              "fade",
              "slide_down",
              "scale_down",
              "cut"
            ],
            "default": "fade",
            "description": "all callouts"
          }
        }
      },
      "cue_times": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maxItems": 5,
        "description": "Seconds from the template start when each element appears, in order: callout 1, callout 2, callout 3, callout 4, callout 5. One cue per callout, when the narrator mentions it. Compute as (spoken word time − beat start time) from WhisperX."
      }
    },
    "required": [
      "callouts"
    ],
    "additionalProperties": false
  },
  "example": {
    "callouts": [
      {
        "label": "Main control room",
        "x": 32,
        "y": 40
      },
      {
        "label": "Cooling towers",
        "x": 70,
        "y": 55,
        "icon": "wind"
      }
    ],
    "marker": "ring",
    "look": "pill"
  }
}
