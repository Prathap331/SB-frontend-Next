    },
    "required": [
      "question"
    ],
    "additionalProperties": false
  },
  "example": {
    "question": "But why did it fail?",
    "highlight": "fail",
    "sub": "The answer surprised everyone.",
    "mark": "left",
    "background": "theme"
  }
}
