    "required": [
      "caption",
      "image_url"
    ],
    "additionalProperties": false
  },
  "example": {
    "image_url": "https://example.com/archive-photo.jpg",
    "date": "1947",
    "caption": "Victoria Terminus, Bombay",
    "credit": "Photo: replace with the real archive credit",
    "treatment": "sepia",
    "look": "print"
  }
}
