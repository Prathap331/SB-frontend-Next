          }
        }
      },
      "font_sizes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Largest font size per element in px. The template still shrinks text that would not fit.",
        "properties": {
          "caption": {
            "type": "number",
            "minimum": 22,
            "maximum": 34,
            "default": 34,
            "description": "Typed caption"
          },
          "date": {
            "type": "number",
