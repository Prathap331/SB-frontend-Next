{
  "template": "EM-04",
  "name": "Scribble Annotation",
  "animation_type": "em_scribble",
  "pick_when": "Pointing at something inside the footage: circle a face, underline a line in a document, cross out a claim.",
  "placement": "overlay",
  "frame": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 100,
    "safe_box": [
      1720,
      880
    ]
  },
  "duration": {
    "frames": [
      45,
      240
    ],
    "seconds": [
      1.5,
      8
    ],
    "default_frames": 120,
    "note": "Length comes from the voice beat (clock.durationInFrames), not from props."
  },
  "rules": [
    "Stay within every limit below; longer text is shortened at a word boundary, too-short or missing required fields are errors.",
    "Numbers are raw values (no commas, units or currency symbols) — the template formats and animates them.",
    "Only real, sourced facts, quotes and figures. Label invented example numbers as illustrative.",
    "Icons are Lucide names from the repository icon map; unknown names render as a circle."
  ],
  "inputs": [
    {
      "path": "marks[]",
      "type": "list",
      "required": true,
      "fills": "Marks, drawn in order",
      "limits": "1–3"
    },
    {
      "path": "marks[].shape",
      "type": "choice",
      "required": true,
      "fills": "circle · underline · box · arrow (points at the spot) · cross · tick",
      "values": [
        "circle",
        "underline",
        "box",
        "arrow",
        "cross",
        "tick"
      ]
    },
    {
      "path": "marks[].x",
      "type": "number",
      "required": true,
      "fills": "Left edge of the spot, % of frame width",
      "limits": "0–100"
    },
    {
      "path": "marks[].y",
      "type": "number",
      "required": true,
      "fills": "Top edge of the spot, % of frame height",
      "limits": "0–100"
    },
    {
      "path": "marks[].w",
      "type": "number",
      "required": true,
      "fills": "Width of the spot, % of frame width",
      "limits": "1–100"
    },
    {
      "path": "marks[].h",
      "type": "number",
      "required": true,
      "fills": "Height of the spot, % of frame height",
      "limits": "1–100"
    },
    {
      "path": "marks[].label",
      "type": "text",
      "required": false,
      "fills": "Handwritten note beside the mark",
      "limits": "1–30 chars · up to 2 lines"
    },
    {
      "path": "color",
      "type": "choice",
      "required": false,
      "fills": "Colour of the marks and notes",
      "values": [
        "red",
        "yellow",
        "white",
        "accent"
      ],
      "default": "red"
    },
    {
      "path": "stroke",
      "type": "choice",
      "required": false,
      "fills": "Marker thickness",
      "values": [
        "thin",
        "medium",
        "thick"
      ],
      "default": "medium"
    },
    {
      "path": "style.heading_font",
      "type": "choice",
      "required": false,
      "fills": "Font for bold text (weight ≥ 700: titles, numbers, headings)",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins"
    },
    {
      "path": "style.body_font",
      "type": "choice",
      "required": false,
      "fills": "Font for all other text",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins (or the heading font)"
    },
    {
      "path": "style.background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "style.background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "style.scrim_color",
      "type": "color",
      "required": false,
      "fills": "Dark overlay behind text on images and footage",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#080A1C"
    },
    {
      "path": "style.text_color",
      "type": "color",
      "required": false,
      "fills": "Main text (titles, labels, numbers)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#FFF6E6"
    },
    {
      "path": "style.muted_color",
      "type": "color",
      "required": false,
      "fills": "Secondary text (subtitles, descriptions, context)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#C9CDE8"
    },
    {
      "path": "style.accent_color",
      "type": "color",
      "required": false,
      "fills": "Accent lines, highlights, kicker, units",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F5A524"
    },
    {
      "path": "background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid) — same as style.background_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour) — same as style.background_2_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "animations.marks",
      "type": "animation",
      "required": false,
      "fills": "each mark (drawn like a pen stroke)",
      "values": [
        "grow",
        "fade",
        "pop",
        "none"
      ],
      "default": "grow",
      "hint": "grow: Draws out from its start; fade: Fades in; pop: Pops in with a small overshoot; none: Appears instantly"
    },
    {
      "path": "animations.labels",
      "type": "animation",
      "required": false,
      "fills": "each handwritten note",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "typewriter",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.exit",
      "type": "animation",
      "required": false,
      "fills": "all marks",
      "values": [
        "fade_up",
        "fade",
        "slide_down",
        "scale_down",
        "cut"
      ],
      "default": "fade",
      "hint": "fade_up: Fades out while moving up; fade: Fades out; slide_down: Moves down while fading out; scale_down: Shrinks slightly while fading out; cut: Disappears instantly at the cut"
    },
    {
      "path": "cue_times",
      "type": "cues",
      "required": false,
      "fills": "When elements appear: mark 1 → mark 2 → mark 3",
      "limits": "seconds from the template start, increasing; One cue per mark: when the narrator points at it."
    }
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "EM-04 Scribble Annotation",
    "type": "object",
    "properties": {
      "marks": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "shape": {
              "type": "string",
              "enum": [
                "circle",
                "underline",
                "box",
                "arrow",
                "cross",
                "tick"
              ]
            },
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "w": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "h": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            }
          }
        }
      },
      "color": {
        "type": "string",
        "enum": [
          "red",
          "yellow",
          "white",
          "accent"
        ],
        "default": "red",
        "description": "Colour of the marks and notes"
      },
      "stroke": {
        "type": "string",
        "enum": [
          "thin",
          "medium",
          "thick"
        ],
        "default": "medium",
        "description": "Marker thickness"
      },
      "background_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background (gradient start, or solid) (same as style.background_color; wins over it)"
      },
      "background_2_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background gradient end (set equal to background for a solid colour) (same as style.background_2_color; wins over it)"
      },
      "style": {
        "type": "object",
        "additionalProperties": false,
        "description": "Fonts and colours. Omit any key to use the default.",
        "properties": {
          "heading_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
              "roboto_slab",
              "lora",
              "baloo_2",
              "mukta",
              "hind",
              "kalam"
            ],
            "default": "poppins",
            "description": "Font for weight ≥ 700 text"
          },
          "body_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
              "roboto_slab",
              "lora",
              "baloo_2",
              "mukta",
              "hind",
              "kalam"
            ],
            "description": "Font for other text"
          },
          "background_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Theme background (gradient start, or solid)",
            "default": "#141A45"
          },
          "background_2_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Theme background gradient end (set equal to background for a solid colour)",
            "default": "#0C1030"
          },
          "scrim_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Dark overlay behind text on images and footage",
            "default": "#080A1C"
          },
          "text_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Main text (titles, labels, numbers)",
            "default": "#FFF6E6"
          },
          "muted_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Secondary text (subtitles, descriptions, context)",
            "default": "#C9CDE8"
          },
          "accent_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Accent lines, highlights, kicker, units",
            "default": "#F5A524"
          }
        }
      },
      "font_sizes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Largest font size per element in px. The template still shrinks text that would not fit.",
        "properties": {}
      },
      "animations": {
        "type": "object",
        "additionalProperties": false,
        "description": "Animation preset per element. Omit a key to use its default.",
        "properties": {
          "marks": {
            "type": "string",
            "enum": [
              "grow",
              "fade",
              "pop",
              "none"
            ],
            "default": "grow",
            "description": "each mark (drawn like a pen stroke)"
          },
          "labels": {
            "type": "string",
            "enum": [
              "rise",
              "fade_up",
              "fade",
              "blur_in",
              "scale_in",
              "slam",
              "slide_left",
              "slide_right",
              "none",
              "word_fade",
              "word_pop",
              "typewriter",
              "letter_rise"
            ],
            "default": "typewriter",
            "description": "each handwritten note"
          },
          "exit": {
            "type": "string",
            "enum": [
              "fade_up",
              "fade",
              "slide_down",
              "scale_down",
              "cut"
            ],
            "default": "fade",
            "description": "all marks"
          }
        }
      },
      "cue_times": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maxItems": 3,
        "description": "Seconds from the template start when each element appears, in order: mark 1, mark 2, mark 3. One cue per mark: when the narrator points at it. Compute as (spoken word time − beat start time) from WhisperX."
      }
    },
    "required": [
      "marks"
    ],
    "additionalProperties": false
  },
  "example": {
    "marks": [
      {
        "shape": "circle",
        "x": 40,
        "y": 25,
        "w": 18,
        "h": 30,
        "label": "this one!"
      }
    ],
    "color": "red",
    "stroke": "medium"
  }
}
