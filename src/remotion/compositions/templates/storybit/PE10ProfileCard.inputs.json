      },
      "cue_times": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maxItems": 9,
        "description": "Seconds from the template start when each element appears, in order: card, name, fact 1, fact 2, fact 3, fact 4, fact 5, fact 6, tags. Fixed slots: card → name → fact 1…6 → tags. Compute as (spoken word time − beat start time) from WhisperX."
      }
    },
    "required": [
      "name",
      "facts"
    ],
    "additionalProperties": false
  },
  "example": {
    "name": "Sample Person",
    "role": "Founder & CEO, Example Ltd",
    "facts": [
      {
        "label": "Born",
        "value": "1975, Pune"
      },
      {
        "label": "Education",
        "value": "B.Tech, IIT Bombay"
      },
      {
        "label": "Company value",
        "value": "₹12,000 Cr (illustrative)"
