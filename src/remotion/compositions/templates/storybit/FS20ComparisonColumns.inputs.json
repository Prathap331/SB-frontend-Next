          },
          "image_motion": {
            "type": "string",
            "enum": [
              "push_in",
              "pull_out",
              "pan_left",
              "pan_right",
              "drift",
              "static"
            ],
            "default": "push_in",
            "description": "background image (whole clip)"
          },
          "image_entry": {
            "type": "string",
            "enum": [
              "fade",
              "blur_in",
              "wipe",
              "cut"
            ],
            "default": "fade",
            "description": "background (first 12 frames)"
          },
          "exit": {
            "type": "string",
            "enum": [
              "fade_up",
              "fade",
              "slide_down",
              "scale_down",
              "cut"
            ],
            "default": "fade_up",
            "description": "all foreground content"
          }
        }
      },
      "cue_times": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maxItems": 7,
        "description": "Seconds from the template start when each element appears, in order: heading, row 1, row 2, row 3, row 4, row 5, row 6. First cue = heading (if present), then one cue per row (when the narrator reaches that attribute). Column heads appear just before the first row. Compute as (spoken word time − beat start time) from WhisperX."
      }
    },
    "required": [
      "columns",
      "rows"
    ],
    "additionalProperties": false
  },
