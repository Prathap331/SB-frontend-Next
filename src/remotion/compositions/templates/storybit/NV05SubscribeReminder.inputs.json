            "description": "Chip / card / step fill (default: translucent white, darker over footage)"
          },
          "on_accent_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Icons and numbers drawn on accent-filled shapes",
            "default": "#141A45"
          }
        }
      },
      "font_sizes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Largest font size per element in px. The template still shrinks text that would not fit.",
        "properties": {
          "channel_name": {
            "type": "number",
            "minimum": 22,
            "maximum": 34,
            "default": 34,
            "description": "Name beside the avatar"
          },
          "cta": {
            "type": "number",
            "minimum": 18,
            "maximum": 26,
