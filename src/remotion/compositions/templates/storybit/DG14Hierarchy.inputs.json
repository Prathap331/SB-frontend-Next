      },
      "font_sizes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Largest font size per element in px. The template still shrinks text that would not fit.",
        "properties": {
          "title": {
            "type": "number",
            "minimum": 36,
            "maximum": 52,
            "default": 52,
