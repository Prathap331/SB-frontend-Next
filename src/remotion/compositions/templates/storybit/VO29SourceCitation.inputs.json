            },
            "offset_y": {
              "type": "number"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "animation": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entrance": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "none",
                        "fade",
                        "slide_up",
                        "slide_down",
                        "slide_left",
                        "slide_right",
                        "pop",
                        "zoom_in",
                        "blur_in",
