{
  "template": "VO-29",
  "name": "Source Citation",
  "animation_type": "vo_source_citation",
  "pick_when": "Whenever a number, quote or claim on screen comes from a source — attach it for credibility.",
  "placement": "overlay",
  "frame": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 100,
    "safe_box": [
      1720,
      880
    ]
  },
  "duration": {
    "frames": [
      45,
      240
    ],
    "seconds": [
      1.5,
      8
    ],
    "default_frames": 120,
    "note": "Length comes from the voice beat (clock.durationInFrames), not from props."
  },
  "rules": [
    "Stay within every limit below; longer text is shortened at a word boundary, too-short or missing required fields are errors.",
    "Numbers are raw values (no commas, units or currency symbols) — the template formats and animates them.",
    "Only real, sourced facts, quotes and figures. Label invented example numbers as illustrative.",
    "Icons are Lucide names from the repository icon map; unknown names render as a circle."
  ],
  "inputs": [
    {
      "path": "source",
      "type": "text",
      "required": true,
      "fills": "Source name",
      "limits": "3–48 chars · 1–8 words · longest word 18 · max 1 line",
      "hint": "\"RBI Annual Report\", \"The Hindu\".",
      "example": "RBI Annual Report"
    },
    {
      "path": "date",
      "type": "text",
      "required": false,
      "fills": "Date after the source",
      "limits": "2–20 chars · 1–4 words · longest word 12 · max 1 line",
      "hint": "\"2024–25\", \"12 March 2025\".",
      "example": "2024–25"
    },
    {
      "path": "prefix_label",
      "type": "text",
      "required": false,
      "fills": "Word before the source",
      "limits": "2–12 chars · 1–2 words · longest word 12 · max 1 line",
      "hint": "Word before the source (default \"Source\").",
      "example": "Source"
    },
    {
      "path": "icon",
      "type": "icon",
      "required": false,
      "fills": "Small icon at the start",
      "limits": "Lucide icon name",
      "fallback": "file-text",
      "example": "file-text"
    },
    {
      "path": "position",
      "type": "choice",
      "required": false,
      "fills": "Where the tag sits inside the safe box",
      "values": [
        "top_left",
        "top_right",
        "bottom_left",
        "bottom_right",
        "bottom_center",
        "top_center",
        "center"
      ],
      "default": "bottom_right"
    },
    {
      "path": "look",
      "type": "choice",
      "required": false,
      "fills": "Small dark tag, or text with shadow only",
      "values": [
        "tag",
        "plain"
      ],
      "default": "tag"
    },
    {
      "path": "style.heading_font",
      "type": "choice",
      "required": false,
      "fills": "Font for bold text (weight ≥ 700: titles, numbers, headings)",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins"
    },
    {
      "path": "style.body_font",
      "type": "choice",
      "required": false,
      "fills": "Font for all other text",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins (or the heading font)"
    },
    {
      "path": "style.background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "style.background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "style.scrim_color",
      "type": "color",
      "required": false,
      "fills": "Dark overlay behind text on images and footage",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#080A1C"
    },
    {
      "path": "style.text_color",
      "type": "color",
      "required": false,
      "fills": "Main text (titles, labels, numbers)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#FFF6E6"
    },
    {
      "path": "style.muted_color",
      "type": "color",
      "required": false,
      "fills": "Secondary text (subtitles, descriptions, context)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#C9CDE8"
    },
    {
      "path": "style.accent_color",
      "type": "color",
      "required": false,
      "fills": "Accent lines, highlights, kicker, units",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F5A524"
    },
    {
      "path": "style.icon_color",
      "type": "color",
      "required": false,
      "fills": "Icon strokes (default: accent)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.card_color",
      "type": "color",
      "required": false,
      "fills": "Chip / card / step fill (default: translucent white, darker over footage)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid) — same as style.background_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour) — same as style.background_2_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "font_sizes.source",
      "type": "number",
      "required": false,
      "fills": "Font size of source name (px, largest; shrinks only if it would not fit)",
      "limits": "18–26 px",
      "default": 26
    },
    {
      "path": "font_sizes.date",
      "type": "number",
      "required": false,
      "fills": "Font size of date after the source (px, largest; shrinks only if it would not fit)",
      "limits": "18–26 px",
      "default": 26
    },
    {
      "path": "font_sizes.prefix_label",
      "type": "number",
      "required": false,
      "fills": "Font size of word before the source (px, largest; shrinks only if it would not fit)",
      "limits": "18–26 px",
      "default": 26
    },
    {
      "path": "animations.tag",
      "type": "animation",
      "required": false,
      "fills": "the tag",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "fade",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.icon",
      "type": "animation",
      "required": false,
      "fills": "icon",
      "values": [
        "pop",
        "spin_in",
        "bounce",
        "fade",
        "wipe",
        "none"
      ],
      "default": "fade",
      "hint": "pop: Pops in with a small overshoot; spin_in: Spins in a quarter turn while growing; bounce: Drops in and bounces; fade: Fades in; wipe: Revealed left to right; none: Appears instantly"
    },
    {
      "path": "animations.text",
      "type": "animation",
      "required": false,
      "fills": "source text",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "fade",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.exit",
      "type": "animation",
      "required": false,
      "fills": "the tag",
      "values": [
        "fade_up",
        "fade",
        "slide_down",
        "scale_down",
        "cut"
      ],
      "default": "fade",
      "hint": "fade_up: Fades out while moving up; fade: Fades out; slide_down: Moves down while fading out; scale_down: Shrinks slightly while fading out; cut: Disappears instantly at the cut"
    },
    {
      "path": "cue_times",
      "type": "cues",
      "required": false,
      "fills": "When elements appear: source",
      "limits": "seconds from the template start, increasing; When the sourced claim is spoken."
    }
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "VO-29 Source Citation",
    "type": "object",
    "properties": {
      "source": {
        "type": "string",
        "minLength": 3,
        "maxLength": 48,
        "description": "Source name. 1–8 words, longest word 18 letters. \"RBI Annual Report\", \"The Hindu\"."
      },
      "date": {
        "type": "string",
        "minLength": 2,
        "maxLength": 20,
        "description": "Date after the source. 1–4 words, longest word 12 letters. \"2024–25\", \"12 March 2025\"."
      },
      "prefix_label": {
        "type": "string",
        "minLength": 2,
        "maxLength": 12,
        "description": "Word before the source. 1–2 words, longest word 12 letters. Word before the source (default \"Source\")."
      },
      "icon": {
        "type": "string",
        "description": "Small icon at the start. Lucide icon name (kebab-case), e.g. \"file-text\"."
      },
      "position": {
        "type": "string",
        "enum": [
          "top_left",
          "top_right",
          "bottom_left",
          "bottom_right",
          "bottom_center",
          "top_center",
          "center"
        ],
        "default": "bottom_right",
        "description": "Where the tag sits inside the safe box"
      },
      "look": {
        "type": "string",
        "enum": [
          "tag",
          "plain"
        ],
        "default": "tag",
        "description": "Small dark tag, or text with shadow only"
      },
      "background_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background (gradient start, or solid) (same as style.background_color; wins over it)"
      },
      "background_2_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background gradient end (set equal to background for a solid colour) (same as style.background_2_color; wins over it)"
      },
      "style": {
        "type": "object",
        "additionalProperties": false,
        "description": "Fonts and colours. Omit any key to use the default.",
        "properties": {
          "heading_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
