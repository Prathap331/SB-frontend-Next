            },
            "fill": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "border": {
              "type": "object",
              "properties": {
                "color": {
