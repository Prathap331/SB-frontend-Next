{
  "template": "DG-23",
  "name": "Pros & Cons",
  "animation_type": "dg_pros_cons",
  "pick_when": "Weighing the good and the bad of one thing: a policy, a product, a decision.",
  "placement": "full",
  "frame": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 100,
    "safe_box": [
      1720,
      880
    ]
  },
  "duration": {
    "frames": [
      90,
      240
    ],
    "seconds": [
      3,
      8
    ],
    "default_frames": 210,
    "note": "Length comes from the voice beat (clock.durationInFrames), not from props."
  },
  "rules": [
    "Stay within every limit below; longer text is shortened at a word boundary, too-short or missing required fields are errors.",
    "Numbers are raw values (no commas, units or currency symbols) — the template formats and animates them.",
    "Only real, sourced facts, quotes and figures. Label invented example numbers as illustrative.",
    "Icons are Lucide names from the repository icon map; unknown names render as a circle."
  ],
  "inputs": [
    {
      "path": "title",
      "type": "text",
      "required": false,
      "fills": "Subject above the columns",
      "limits": "3–44 chars · 1–8 words · longest word 18 · max 1 line",
      "example": "The new tax regime"
    },
    {
      "path": "pros_label",
      "type": "text",
      "required": false,
      "fills": "Heading of the good column",
      "limits": "2–16 chars · 1–3 words · longest word 14 · max 1 line",
      "hint": "Default \"Pros\" (e.g. \"फ़ायदे\")."
    },
    {
      "path": "cons_label",
      "type": "text",
      "required": false,
      "fills": "Heading of the bad column",
      "limits": "2–16 chars · 1–3 words · longest word 14 · max 1 line",
      "hint": "Default \"Cons\" (e.g. \"नुक़सान\")."
    },
    {
      "path": "verdict",
      "type": "text",
      "required": false,
      "fills": "Verdict under the columns",
      "limits": "5–80 chars · 2–14 words · longest word 18 · max 2 lines",
      "hint": "One-line conclusion."
    },
    {
      "path": "pros[]",
      "type": "list",
      "required": true,
      "fills": "Good points",
      "limits": "1–5 items"
    },
    {
      "path": "pros[].text",
      "type": "text",
      "required": true,
      "fills": "One point",
      "limits": "2–60 chars · 1–11 words · longest word 16 · max 2 lines"
    },
    {
      "path": "cons[]",
      "type": "list",
      "required": true,
      "fills": "Bad points",
      "limits": "1–5 items"
    },
    {
      "path": "cons[].text",
      "type": "text",
      "required": true,
      "fills": "One point",
      "limits": "2–60 chars · 1–11 words · longest word 16 · max 2 lines"
    },
    {
      "path": "image_url",
      "type": "image",
      "required": false,
      "fills": "Full-bleed background (used when background = \"image\")",
      "limits": "https URL or asset URL"
    },
    {
      "path": "order",
      "type": "choice",
      "required": false,
      "fills": "pro, con, pro, con… or all pros then all cons",
      "values": [
        "alternate",
        "columns"
      ],
      "default": "alternate"
    },
    {
      "path": "background",
      "type": "choice",
      "required": false,
      "fills": "theme gradient, image_url, or transparent over footage",
      "values": [
        "theme",
        "image",
        "transparent"
      ],
      "default": "theme"
    },
    {
      "path": "style.heading_font",
      "type": "choice",
      "required": false,
      "fills": "Font for bold text (weight ≥ 700: titles, numbers, headings)",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins"
    },
    {
      "path": "style.body_font",
      "type": "choice",
      "required": false,
      "fills": "Font for all other text",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins (or the heading font)"
    },
    {
      "path": "style.background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "style.background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "style.scrim_color",
      "type": "color",
      "required": false,
      "fills": "Dark overlay behind text on images and footage",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#080A1C"
    },
    {
      "path": "style.text_color",
      "type": "color",
      "required": false,
      "fills": "Main text (titles, labels, numbers)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#FFF6E6"
    },
    {
      "path": "style.muted_color",
      "type": "color",
      "required": false,
      "fills": "Secondary text (subtitles, descriptions, context)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#C9CDE8"
    },
    {
      "path": "style.accent_color",
      "type": "color",
      "required": false,
      "fills": "Accent lines, highlights, kicker, units",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F5A524"
    },
    {
      "path": "style.card_color",
      "type": "color",
      "required": false,
      "fills": "Chip / card / step fill (default: translucent white, darker over footage)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.card_border_color",
      "type": "color",
      "required": false,
      "fills": "Chip / card outline (default: translucent white)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.positive_color",
      "type": "color",
      "required": false,
      "fills": "Good change (up arrows, gains)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#34D399"
    },
    {
      "path": "style.negative_color",
      "type": "color",
      "required": false,
      "fills": "Bad change (down arrows, losses)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F87171"
    },
    {
      "path": "background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid) — same as style.background_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour) — same as style.background_2_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "font_sizes.title",
      "type": "number",
      "required": false,
      "fills": "Font size of subject above the columns (px, largest; shrinks only if it would not fit)",
      "limits": "38–56 px",
      "default": 56
    },
    {
      "path": "font_sizes.pros_label",
      "type": "number",
      "required": false,
      "fills": "Font size of heading of the good column (px, largest; shrinks only if it would not fit)",
      "limits": "22–34 px",
      "default": 34
    },
    {
      "path": "font_sizes.cons_label",
      "type": "number",
      "required": false,
      "fills": "Font size of heading of the bad column (px, largest; shrinks only if it would not fit)",
      "limits": "22–34 px",
      "default": 34
    },
    {
      "path": "font_sizes.verdict",
      "type": "number",
      "required": false,
      "fills": "Font size of verdict under the columns (px, largest; shrinks only if it would not fit)",
      "limits": "22–34 px",
      "default": 34
    },
    {
      "path": "font_sizes.pros.text",
      "type": "number",
      "required": false,
      "fills": "Font size of one point (px, largest; shrinks only if it would not fit)",
      "limits": "20–34 px",
      "default": 34
    },
    {
      "path": "font_sizes.cons.text",
      "type": "number",
      "required": false,
      "fills": "Font size of one point (px, largest; shrinks only if it would not fit)",
      "limits": "20–34 px",
      "default": 34
    },
    {
      "path": "animations.title",
      "type": "animation",
      "required": false,
      "fills": "heading",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "rise",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.columns",
      "type": "animation",
      "required": false,
      "fills": "the two column panels",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "fade",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.points",
      "type": "animation",
      "required": false,
      "fills": "each point",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "slide_up",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.marks",
      "type": "animation",
      "required": false,
      "fills": "✓ / ✕ of each point",
      "values": [
        "pop",
        "spin_in",
        "bounce",
        "fade",
        "wipe",
        "none"
      ],
      "default": "pop",
      "hint": "pop: Pops in with a small overshoot; spin_in: Spins in a quarter turn while growing; bounce: Drops in and bounces; fade: Fades in; wipe: Revealed left to right; none: Appears instantly"
    },
    {
      "path": "animations.verdict",
      "type": "animation",
      "required": false,
      "fills": "verdict line",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "fade_up",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.image_motion",
      "type": "animation",
      "required": false,
      "fills": "background image",
      "values": [
        "push_in",
        "pull_out",
        "pan_left",
        "pan_right",
        "drift",
        "static"
      ],
      "default": "push_in",
      "hint": "push_in: Slow zoom in (1.00 → 1.08); pull_out: Slow zoom out (1.08 → 1.00); pan_left: Slow pan towards the left; pan_right: Slow pan towards the right; drift: Slow zoom with a slight rotation; static: No movement"
    },
    {
      "path": "animations.image_entry",
      "type": "animation",
      "required": false,
      "fills": "background (first 12 frames)",
      "values": [
        "fade",
        "blur_in",
        "wipe",
        "cut"
      ],
      "default": "fade",
      "hint": "fade: Fades in; blur_in: Sharpens from a blur; wipe: Revealed left to right; cut: No transition"
    },
    {
      "path": "animations.exit",
      "type": "animation",
      "required": false,
      "fills": "everything",
      "values": [
        "fade_up",
        "fade",
        "slide_down",
        "scale_down",
        "cut"
      ],
      "default": "fade_up",
      "hint": "fade_up: Fades out while moving up; fade: Fades out; slide_down: Moves down while fading out; scale_down: Shrinks slightly while fading out; cut: Disappears instantly at the cut"
    },
    {
      "path": "cue_times",
      "type": "cues",
      "required": false,
      "fills": "When elements appear: heading → point 1 → point 2 → point 3 → point 4 → point 5 → point 6 → point 7 → point 8 → point 9 → point 10 → verdict",
      "limits": "seconds from the template start, increasing; Fixed slots: heading → point 1…10 (in reveal order) → verdict."
    }
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "DG-23 Pros & Cons",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 3,
        "maxLength": 44,
        "description": "Subject above the columns. 1–8 words, longest word 18 letters."
      },
      "pros_label": {
        "type": "string",
        "minLength": 2,
        "maxLength": 16,
        "description": "Heading of the good column. 1–3 words, longest word 14 letters. Default \"Pros\" (e.g. \"फ़ायदे\")."
      },
      "cons_label": {
        "type": "string",
        "minLength": 2,
        "maxLength": 16,
        "description": "Heading of the bad column. 1–3 words, longest word 14 letters. Default \"Cons\" (e.g. \"नुक़सान\")."
      },
      "verdict": {
        "type": "string",
        "minLength": 5,
        "maxLength": 80,
        "description": "Verdict under the columns. 2–14 words, longest word 18 letters. One-line conclusion."
      },
      "pros": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60,
              "description": "One point. 1–11 words, longest word 16 letters."
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "description": "Good points"
      },
      "cons": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 2,
              "maxLength": 60,
              "description": "One point. 1–11 words, longest word 16 letters."
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "description": "Bad points"
      },
      "image_url": {
        "type": "string",
