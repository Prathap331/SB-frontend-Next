{
  "template": "DG-17",
  "name": "Architecture Diagram",
  "animation_type": "dg_architecture",
  "pick_when": "How a system works inside: what connects to what (UPI, a data centre, an app, the power grid).",
  "placement": "full",
  "frame": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 100,
    "safe_box": [
      1720,
      880
    ]
  },
  "duration": {
    "frames": [
      90,
      240
    ],
    "seconds": [
      3,
      8
    ],
    "default_frames": 210,
    "note": "Length comes from the voice beat (clock.durationInFrames), not from props."
  },
  "rules": [
    "Stay within every limit below; longer text is shortened at a word boundary, too-short or missing required fields are errors.",
    "Numbers are raw values (no commas, units or currency symbols) — the template formats and animates them.",
    "Only real, sourced facts, quotes and figures. Label invented example numbers as illustrative.",
    "Icons are Lucide names from the repository icon map; unknown names render as a circle."
  ],
  "inputs": [
    {
      "path": "title",
      "type": "text",
      "required": false,
      "fills": "Heading above the diagram",
      "limits": "3–44 chars · 1–8 words · longest word 18 · max 1 line",
      "example": "How a UPI payment flows"
    },
    {
      "path": "layers[]",
      "type": "list",
      "required": true,
      "fills": "Columns left to right",
      "limits": "2–4 layers"
    },
    {
      "path": "layers[].name",
      "type": "text",
      "required": true,
      "fills": "Layer heading (\"Your phone\", \"Switch\", \"Banks\")",
      "limits": "2–22 chars"
    },
    {
      "path": "layers[].bg_color",
      "type": "color",
      "required": false,
      "fills": "Background colour of this layer column (to highlight it)",
      "limits": "hex #RRGGBB"
    },
    {
      "path": "layers[].nodes[]",
      "type": "list",
      "required": true,
      "fills": "Components in this layer, top to bottom",
      "limits": "1–4 per layer"
    },
    {
      "path": "layers[].nodes[].label",
      "type": "text",
      "required": true,
      "fills": "Component name (links refer to it)",
      "limits": "2–24 chars · unique"
    },
    {
      "path": "layers[].nodes[].sub",
      "type": "text",
      "required": false,
      "fills": "Small detail line",
      "limits": "2–28 chars"
    },
    {
      "path": "layers[].nodes[].icon",
      "type": "icon",
      "required": false,
      "fills": "Lucide icon name"
    },
    {
      "path": "links[]",
      "type": "list",
      "required": false,
      "fills": "Arrows, in reveal order",
      "limits": "up to 8"
    },
    {
      "path": "links[].from",
      "type": "text",
      "required": true,
      "fills": "Label of the component the arrow starts at"
    },
    {
      "path": "links[].to",
      "type": "text",
      "required": true,
      "fills": "Label of the component the arrow points to"
    },
    {
      "path": "links[].label",
      "type": "text",
      "required": false,
      "fills": "Words on the arrow",
      "limits": "2–16 chars"
    },
    {
      "path": "image_url",
      "type": "image",
      "required": false,
      "fills": "Full-bleed background (used when background = \"image\")",
      "limits": "https URL or asset URL"
    },
    {
      "path": "background",
      "type": "choice",
      "required": false,
      "fills": "theme gradient, image_url, or transparent over footage",
      "values": [
        "theme",
        "image",
        "transparent"
      ],
      "default": "theme"
    },
    {
      "path": "style.heading_font",
      "type": "choice",
      "required": false,
      "fills": "Font for bold text (weight ≥ 700: titles, numbers, headings)",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins"
    },
    {
      "path": "style.body_font",
      "type": "choice",
      "required": false,
      "fills": "Font for all other text",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins (or the heading font)"
    },
    {
      "path": "style.background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "style.background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "style.scrim_color",
      "type": "color",
      "required": false,
      "fills": "Dark overlay behind text on images and footage",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#080A1C"
    },
    {
      "path": "style.text_color",
      "type": "color",
      "required": false,
      "fills": "Main text (titles, labels, numbers)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#FFF6E6"
    },
    {
      "path": "style.muted_color",
      "type": "color",
      "required": false,
      "fills": "Secondary text (subtitles, descriptions, context)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#C9CDE8"
    },
    {
      "path": "style.accent_color",
      "type": "color",
      "required": false,
      "fills": "Accent lines, highlights, kicker, units",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F5A524"
    },
    {
      "path": "style.icon_color",
      "type": "color",
      "required": false,
      "fills": "Icon strokes (default: accent)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.icon_bg_color",
      "type": "color",
      "required": false,
      "fills": "Circle behind icons (default: accent at 18%)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.card_color",
      "type": "color",
      "required": false,
      "fills": "Chip / card / step fill (default: translucent white, darker over footage)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.card_border_color",
      "type": "color",
      "required": false,
      "fills": "Chip / card outline (default: translucent white)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.series_2_color",
      "type": "color",
      "required": false,
      "fills": "Second data series / slice (the first uses accent)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#22D3EE"
    },
    {
      "path": "style.series_3_color",
      "type": "color",
      "required": false,
      "fills": "Third data series / slice",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#A78BFA"
    },
    {
      "path": "style.series_4_color",
      "type": "color",
      "required": false,
      "fills": "Fourth data series / slice",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F472B6"
    },
    {
      "path": "background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid) — same as style.background_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour) — same as style.background_2_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "font_sizes.title",
      "type": "number",
      "required": false,
      "fills": "Font size of heading above the diagram (px, largest; shrinks only if it would not fit)",
      "limits": "36–52 px",
      "default": 52
    },
    {
      "path": "animations.title",
      "type": "animation",
      "required": false,
      "fills": "heading",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "rise",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.layers",
      "type": "animation",
      "required": false,
      "fills": "each layer column",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "slide_left",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.arrows",
      "type": "animation",
      "required": false,
      "fills": "each arrow",
      "values": [
        "grow",
        "fade",
        "pop",
        "none"
      ],
      "default": "grow",
      "hint": "grow: Draws out from its start; fade: Fades in; pop: Pops in with a small overshoot; none: Appears instantly"
    },
    {
      "path": "animations.link_labels",
      "type": "animation",
      "required": false,
      "fills": "words on each arrow",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "pop",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.image_motion",
      "type": "animation",
      "required": false,
      "fills": "background image",
      "values": [
        "push_in",
        "pull_out",
        "pan_left",
        "pan_right",
        "drift",
        "static"
      ],
      "default": "push_in",
      "hint": "push_in: Slow zoom in (1.00 → 1.08); pull_out: Slow zoom out (1.08 → 1.00); pan_left: Slow pan towards the left; pan_right: Slow pan towards the right; drift: Slow zoom with a slight rotation; static: No movement"
    },
    {
      "path": "animations.image_entry",
      "type": "animation",
      "required": false,
      "fills": "background (first 12 frames)",
      "values": [
        "fade",
        "blur_in",
        "wipe",
        "cut"
      ],
      "default": "fade",
      "hint": "fade: Fades in; blur_in: Sharpens from a blur; wipe: Revealed left to right; cut: No transition"
    },
    {
      "path": "animations.exit",
      "type": "animation",
      "required": false,
      "fills": "the diagram",
      "values": [
        "fade_up",
        "fade",
        "slide_down",
        "scale_down",
        "cut"
      ],
      "default": "fade_up",
      "hint": "fade_up: Fades out while moving up; fade: Fades out; slide_down: Moves down while fading out; scale_down: Shrinks slightly while fading out; cut: Disappears instantly at the cut"
    },
    {
      "path": "cue_times",
      "type": "cues",
      "required": false,
      "fills": "When elements appear: heading → layer 1 → layer 2 → layer 3 → layer 4 → arrow 1 → arrow 2 → arrow 3 → arrow 4 → arrow 5 → arrow 6 → arrow 7 → arrow 8",
      "limits": "seconds from the template start, increasing; Fixed slots: heading → layer 1…4 → arrow 1…8."
    }
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "DG-17 Architecture Diagram",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 3,
        "maxLength": 44,
        "description": "Heading above the diagram. 1–8 words, longest word 18 letters."
      },
      "layers": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "nodes"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 22
            },
            "bg_color": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 24
                  },
                  "sub": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 28
                  },
                  "icon": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "links": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "label": {
              "type": "string",
              "minLength": 2,
              "maxLength": 16
            }
          }
        }
      },
      "image_url": {
        "type": "string",
        "format": "uri",
        "description": "Full-bleed background (used when background = \"image\")"
      },
      "background": {
        "type": "string",
        "enum": [
          "theme",
          "image",
          "transparent"
        ],
        "default": "theme",
        "description": "theme gradient, image_url, or transparent over footage"
      },
      "background_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background (gradient start, or solid) (same as style.background_color; wins over it)"
      },
      "background_2_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background gradient end (set equal to background for a solid colour) (same as style.background_2_color; wins over it)"
      },
      "style": {
        "type": "object",
        "additionalProperties": false,
        "description": "Fonts and colours. Omit any key to use the default.",
        "properties": {
          "heading_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
              "roboto_slab",
              "lora",
              "baloo_2",
              "mukta",
              "hind",
              "kalam"
            ],
            "default": "poppins",
            "description": "Font for weight ≥ 700 text"
          },
          "body_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
              "roboto_slab",
              "lora",
              "baloo_2",
              "mukta",
              "hind",
              "kalam"
            ],
            "description": "Font for other text"
          },
          "background_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Theme background (gradient start, or solid)",
            "default": "#141A45"
          },
          "background_2_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Theme background gradient end (set equal to background for a solid colour)",
            "default": "#0C1030"
          },
          "scrim_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Dark overlay behind text on images and footage",
            "default": "#080A1C"
          },
          "text_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Main text (titles, labels, numbers)",
            "default": "#FFF6E6"
          },
          "muted_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Secondary text (subtitles, descriptions, context)",
            "default": "#C9CDE8"
          },
          "accent_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Accent lines, highlights, kicker, units",
            "default": "#F5A524"
          },
          "icon_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Icon strokes (default: accent)"
          },
          "icon_bg_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Circle behind icons (default: accent at 18%)"
          },
          "card_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Chip / card / step fill (default: translucent white, darker over footage)"
          },
          "card_border_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Chip / card outline (default: translucent white)"
          },
          "series_2_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Second data series / slice (the first uses accent)",
            "default": "#22D3EE"
          },
          "series_3_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Third data series / slice",
            "default": "#A78BFA"
          },
          "series_4_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Fourth data series / slice",
            "default": "#F472B6"
          }
        }
      },
      "font_sizes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Largest font size per element in px. The template still shrinks text that would not fit.",
        "properties": {
          "title": {
            "type": "number",
            "minimum": 36,
            "maximum": 52,
            "default": 52,
            "description": "Heading above the diagram"
          }
        }
      },
      "animations": {
        "type": "object",
        "additionalProperties": false,
        "description": "Animation preset per element. Omit a key to use its default.",
        "properties": {
          "title": {
            "type": "string",
            "enum": [
              "rise",
              "fade_up",
              "fade",
              "blur_in",
              "scale_in",
              "slam",
              "slide_left",
              "slide_right",
              "none",
              "word_fade",
              "word_pop",
              "typewriter",
              "letter_rise"
            ],
            "default": "rise",
            "description": "heading"
          },
          "layers": {
            "type": "string",
            "enum": [
              "pop",
              "slide_up",
              "slide_left",
              "fade",
              "none"
            ],
            "default": "slide_left",
            "description": "each layer column"
          },
          "arrows": {
            "type": "string",
            "enum": [
              "grow",
              "fade",
              "pop",
              "none"
            ],
            "default": "grow",
            "description": "each arrow"
          },
          "link_labels": {
            "type": "string",
            "enum": [
              "pop",
              "slide_up",
              "slide_left",
              "fade",
              "none"
            ],
            "default": "pop",
            "description": "words on each arrow"
          },
          "image_motion": {
            "type": "string",
            "enum": [
              "push_in",
              "pull_out",
              "pan_left",
              "pan_right",
              "drift",
              "static"
            ],
            "default": "push_in",
            "description": "background image"
          },
          "image_entry": {
            "type": "string",
            "enum": [
              "fade",
              "blur_in",
              "wipe",
              "cut"
            ],
            "default": "fade",
            "description": "background (first 12 frames)"
          },
          "exit": {
            "type": "string",
            "enum": [
              "fade_up",
              "fade",
              "slide_down",
              "scale_down",
              "cut"
            ],
            "default": "fade_up",
            "description": "the diagram"
          }
        }
      },
      "cue_times": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maxItems": 13,
        "description": "Seconds from the template start when each element appears, in order: heading, layer 1, layer 2, layer 3, layer 4, arrow 1, arrow 2, arrow 3, arrow 4, arrow 5, arrow 6, arrow 7, arrow 8. Fixed slots: heading → layer 1…4 → arrow 1…8. Compute as (spoken word time − beat start time) from WhisperX."
      }
    },
    "required": [
      "layers"
