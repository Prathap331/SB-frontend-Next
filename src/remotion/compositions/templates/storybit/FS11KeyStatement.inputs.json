      },
      "font_sizes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Largest font size per element in px. The template still shrinks text that would not fit.",
        "properties": {
          "statement": {
            "type": "number",
            "minimum": 56,
            "maximum": 110,
