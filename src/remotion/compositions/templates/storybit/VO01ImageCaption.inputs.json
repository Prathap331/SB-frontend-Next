{
  "template": "VO-01",
  "name": "Image + Label / Caption",
  "animation_type": "vo_image_caption",
  "pick_when": "Showing a specific photo that needs a name or one line of explanation (a place, an object, an archive picture).",
  "placement": "both",
  "frame": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 100,
    "safe_box": [
      1720,
      880
    ]
  },
  "duration": {
    "frames": [
      90,
      240
    ],
    "seconds": [
      3,
      8
    ],
    "default_frames": 150,
    "note": "Length comes from the voice beat (clock.durationInFrames), not from props."
  },
  "rules": [
    "Stay within every limit below; longer text is shortened at a word boundary, too-short or missing required fields are errors.",
    "Numbers are raw values (no commas, units or currency symbols) — the template formats and animates them.",
    "Only real, sourced facts, quotes and figures. Label invented example numbers as illustrative.",
    "Icons are Lucide names from the repository icon map; unknown names render as a circle."
  ],
  "inputs": [
    {
      "path": "label",
      "type": "text",
      "required": false,
      "fills": "Label tag",
      "limits": "2–30 chars · 1–5 words · longest word 18 · max 1 line",
      "hint": "What it is: \"Gateway of India, 1924\".",
      "example": "Howrah Bridge, Kolkata"
    },
    {
      "path": "caption",
      "type": "text",
      "required": false,
      "fills": "Caption under the label",
      "limits": "5–100 chars · 2–18 words · longest word 18 · max 2 lines",
      "hint": "One or two lines that explain the picture.",
      "example": "Opened in 1943, it carries more than a lakh vehicles a day"
    },
    {
      "path": "credit",
      "type": "text",
      "required": false,
      "fills": "Small credit in the opposite corner",
      "limits": "3–40 chars · 1–7 words · longest word 18 · max 1 line",
      "hint": "Photo credit or source: \"Photo: Wikimedia Commons\"."
    },
    {
      "path": "image_url",
      "type": "image",
      "required": false,
      "fills": "The photo, full frame (omit to overlay the label / caption on footage)",
      "limits": "https URL or asset URL"
    },
    {
      "path": "position",
      "type": "choice",
      "required": false,
      "fills": "Where the label and caption sit (inside the safe box)",
      "values": [
        "bottom_left",
        "bottom_center",
        "top_left"
      ],
      "default": "bottom_left"
    },
    {
      "path": "fit",
      "type": "choice",
      "required": false,
      "fills": "Fill the frame (crops edges) or show the whole image over a blurred copy",
      "values": [
        "cover",
        "contain"
      ],
      "default": "cover"
    },
    {
      "path": "caption_style",
      "type": "choice",
      "required": false,
      "fills": "panel: dark rounded box · bar: full-width strip along the bottom of the safe box · plain: text with a shadow",
      "values": [
        "panel",
        "bar",
        "plain"
      ],
      "default": "panel"
    },
    {
      "path": "style.heading_font",
      "type": "choice",
      "required": false,
      "fills": "Font for bold text (weight ≥ 700: titles, numbers, headings)",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins"
    },
    {
      "path": "style.body_font",
      "type": "choice",
      "required": false,
      "fills": "Font for all other text",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins (or the heading font)"
    },
    {
      "path": "style.background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "style.background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "style.scrim_color",
      "type": "color",
      "required": false,
      "fills": "Dark overlay behind text on images and footage",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#080A1C"
    },
    {
      "path": "style.text_color",
      "type": "color",
      "required": false,
      "fills": "Main text (titles, labels, numbers)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#FFF6E6"
    },
    {
      "path": "style.muted_color",
      "type": "color",
      "required": false,
      "fills": "Secondary text (subtitles, descriptions, context)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#C9CDE8"
    },
    {
      "path": "style.accent_color",
      "type": "color",
      "required": false,
      "fills": "Accent lines, highlights, kicker, units",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F5A524"
    },
    {
      "path": "style.card_color",
      "type": "color",
      "required": false,
      "fills": "Chip / card / step fill (default: translucent white, darker over footage)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid) — same as style.background_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour) — same as style.background_2_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "font_sizes.label",
      "type": "number",
      "required": false,
      "fills": "Font size of label tag (px, largest; shrinks only if it would not fit)",
      "limits": "28–44 px",
      "default": 44
    },
    {
      "path": "font_sizes.caption",
      "type": "number",
      "required": false,
      "fills": "Font size of caption under the label (px, largest; shrinks only if it would not fit)",
      "limits": "26–38 px",
      "default": 38
    },
    {
      "path": "font_sizes.credit",
      "type": "number",
      "required": false,
      "fills": "Font size of small credit in the opposite corner (px, largest; shrinks only if it would not fit)",
      "limits": "18–22 px",
      "default": 22
    },
    {
      "path": "animations.image_motion",
      "type": "animation",
      "required": false,
      "fills": "the image (whole clip)",
      "values": [
        "push_in",
        "pull_out",
        "pan_left",
        "pan_right",
        "drift",
        "static"
      ],
      "default": "push_in",
      "hint": "push_in: Slow zoom in (1.00 → 1.08); pull_out: Slow zoom out (1.08 → 1.00); pan_left: Slow pan towards the left; pan_right: Slow pan towards the right; drift: Slow zoom with a slight rotation; static: No movement"
    },
    {
      "path": "animations.image_entry",
      "type": "animation",
      "required": false,
      "fills": "the image (first 12 frames)",
      "values": [
        "fade",
        "blur_in",
        "wipe",
        "cut"
      ],
      "default": "fade",
      "hint": "fade: Fades in; blur_in: Sharpens from a blur; wipe: Revealed left to right; cut: No transition"
    },
    {
      "path": "animations.panel",
      "type": "animation",
      "required": false,
      "fills": "caption panel / bar",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "slide_up",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.label",
      "type": "animation",
      "required": false,
      "fills": "label tag",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "slide_left",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.caption",
      "type": "animation",
      "required": false,
      "fills": "caption",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "fade_up",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.credit",
      "type": "animation",
      "required": false,
      "fills": "credit",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "fade",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.exit",
      "type": "animation",
      "required": false,
      "fills": "label, caption and credit",
      "values": [
        "fade_up",
        "fade",
        "slide_down",
        "scale_down",
        "cut"
      ],
      "default": "fade",
      "hint": "fade_up: Fades out while moving up; fade: Fades out; slide_down: Moves down while fading out; scale_down: Shrinks slightly while fading out; cut: Disappears instantly at the cut"
    },
    {
      "path": "cue_times",
      "type": "cues",
      "required": false,
      "fills": "When elements appear: label → caption",
      "limits": "seconds from the template start, increasing; label → caption. Missing elements are skipped."
    }
  ],
