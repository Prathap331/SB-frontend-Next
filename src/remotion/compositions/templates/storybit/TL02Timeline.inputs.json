{
  "template": "TL-02",
  "name": "Timeline",
  "animation_type": "tl_timeline",
  "pick_when": "Several dated events in order: a history, a biography, a company's journey, how something unfolded.",
  "placement": "both",
  "frame": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 100,
    "safe_box": [
      1720,
      880
    ]
  },
  "duration": {
    "frames": [
      90,
      240
    ],
    "seconds": [
      3,
      8
    ],
    "default_frames": 210,
    "note": "Length comes from the voice beat (clock.durationInFrames), not from props."
  },
  "rules": [
    "Stay within every limit below; longer text is shortened at a word boundary, too-short or missing required fields are errors.",
    "Numbers are raw values (no commas, units or currency symbols) — the template formats and animates them.",
    "Only real, sourced facts, quotes and figures. Label invented example numbers as illustrative.",
    "Icons are Lucide names from the repository icon map; unknown names render as a circle."
  ],
  "inputs": [
    {
      "path": "title",
      "type": "text",
      "required": false,
      "fills": "Heading above the timeline",
      "limits": "3–50 chars · 1–10 words · longest word 18 · max 1 line",
      "hint": "\"The UPI story\".",
      "example": "How UPI grew (illustrative)"
    },
    {
      "path": "source",
      "type": "text",
      "required": false,
      "fills": "Source line under the timeline",
      "limits": "3–60 chars · 1–10 words · longest word 18 · max 1 line"
    },
    {
      "path": "events[]",
      "type": "list",
      "required": true,
      "fills": "Events in time order",
      "limits": "3–8 items"
    },
    {
      "path": "events[].date",
      "type": "text",
      "required": true,
      "fills": "Date above the title",
      "limits": "1–20 chars · 1–4 words · longest word 12 · max 1 line",
      "hint": "\"2016\", \"Aug 2016\", \"15 Aug 1947\"."
    },
    {
      "path": "events[].title",
      "type": "text",
      "required": true,
      "fills": "Event title",
      "limits": "2–35 chars · 1–6 words · longest word 14 · max 2 lines",
      "hint": "What happened, in a few words."
    },
    {
      "path": "events[].desc",
      "type": "text",
      "required": false,
      "fills": "Detail under the title",
      "limits": "5–70 chars · 2–12 words · longest word 14 · max 3 lines",
      "hint": "One short line of detail."
    },
    {
      "path": "events[].milestone",
      "type": "number",
      "required": false,
      "fills": "1 = bigger filled accent node and accent-coloured title",
      "limits": "integer · ≥ 0 · ≤ 1"
    },
    {
      "path": "events[].icon",
      "type": "icon",
      "required": false,
      "fills": "Event icon",
      "limits": "Lucide icon name",
      "fallback": "dot"
    },
    {
      "path": "events[].image_url",
      "type": "image",
      "required": false,
      "fills": "Picture inside the event node (circle)",
      "limits": "https URL or asset URL"
    },
    {
      "path": "image_url",
      "type": "image",
      "required": false,
      "fills": "Full-bleed background (used when background = \"image\")",
      "limits": "https URL or asset URL"
    },
    {
      "path": "orientation",
      "type": "choice",
      "required": false,
      "fills": "Track across the screen (labels alternate above / below), or down the left side",
      "values": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal"
    },
    {
      "path": "focus",
      "type": "choice",
      "required": false,
      "fills": "Dim earlier events while a new one appears; everything brightens for the hold",
      "values": [
        "off",
        "on"
      ],
      "default": "off"
    },
    {
      "path": "background",
      "type": "choice",
      "required": false,
      "fills": "theme gradient, image_url, or transparent over footage",
      "values": [
        "theme",
        "image",
        "transparent"
      ],
      "default": "theme"
    },
    {
      "path": "style.heading_font",
      "type": "choice",
      "required": false,
      "fills": "Font for bold text (weight ≥ 700: titles, numbers, headings)",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins"
    },
    {
      "path": "style.body_font",
      "type": "choice",
      "required": false,
      "fills": "Font for all other text",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins (or the heading font)"
    },
    {
      "path": "style.background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "style.background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "style.scrim_color",
      "type": "color",
      "required": false,
      "fills": "Dark overlay behind text on images and footage",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#080A1C"
    },
    {
      "path": "style.text_color",
      "type": "color",
      "required": false,
      "fills": "Main text (titles, labels, numbers)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#FFF6E6"
    },
    {
      "path": "style.muted_color",
      "type": "color",
      "required": false,
      "fills": "Secondary text (subtitles, descriptions, context)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#C9CDE8"
    },
    {
      "path": "style.accent_color",
      "type": "color",
      "required": false,
      "fills": "Accent lines, highlights, kicker, units",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F5A524"
    },
    {
      "path": "style.icon_color",
      "type": "color",
      "required": false,
      "fills": "Icon strokes (default: accent)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.icon_bg_color",
      "type": "color",
      "required": false,
      "fills": "Circle behind icons (default: accent at 18%)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.on_accent_color",
      "type": "color",
      "required": false,
      "fills": "Icons and numbers drawn on accent-filled shapes",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid) — same as style.background_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour) — same as style.background_2_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "font_sizes.title",
      "type": "number",
      "required": false,
      "fills": "Font size of heading above the timeline (px, largest; shrinks only if it would not fit)",
      "limits": "40–60 px",
      "default": 60
    },
    {
      "path": "font_sizes.source",
      "type": "number",
      "required": false,
      "fills": "Font size of source line under the timeline (px, largest; shrinks only if it would not fit)",
      "limits": "18–24 px",
      "default": 24
    },
    {
      "path": "font_sizes.events.date",
      "type": "number",
      "required": false,
      "fills": "Font size of date above the title (px, largest; shrinks only if it would not fit)",
      "limits": "20–34 px",
      "default": 34
    },
    {
      "path": "font_sizes.events.title",
      "type": "number",
      "required": false,
      "fills": "Font size of event title (px, largest; shrinks only if it would not fit)",
      "limits": "20–34 px",
      "default": 34
    },
    {
      "path": "font_sizes.events.desc",
      "type": "number",
      "required": false,
      "fills": "Font size of detail under the title (px, largest; shrinks only if it would not fit)",
      "limits": "16–24 px",
      "default": 24
    },
    {
      "path": "animations.title",
      "type": "animation",
      "required": false,
      "fills": "heading",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "rise",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.track",
      "type": "animation",
      "required": false,
      "fills": "the timeline line (draws along)",
      "values": [
        "grow",
        "fade",
        "pop",
        "none"
      ],
      "default": "grow",
      "hint": "grow: Draws out from its start; fade: Fades in; pop: Pops in with a small overshoot; none: Appears instantly"
    },
    {
      "path": "animations.nodes",
      "type": "animation",
      "required": false,
      "fills": "node of each event",
      "values": [
        "pop",
        "spin_in",
        "bounce",
        "fade",
        "wipe",
        "none"
      ],
      "default": "pop",
      "hint": "pop: Pops in with a small overshoot; spin_in: Spins in a quarter turn while growing; bounce: Drops in and bounces; fade: Fades in; wipe: Revealed left to right; none: Appears instantly"
    },
    {
      "path": "animations.dates",
      "type": "animation",
      "required": false,
      "fills": "date of each event",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "fade_up",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.titles",
      "type": "animation",
      "required": false,
      "fills": "title of each event",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "fade_up",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.descs",
      "type": "animation",
      "required": false,
      "fills": "description of each event",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "fade",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.source",
      "type": "animation",
      "required": false,
      "fills": "source line",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "fade",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.image_motion",
      "type": "animation",
      "required": false,
      "fills": "background image (whole clip)",
      "values": [
        "push_in",
        "pull_out",
        "pan_left",
        "pan_right",
        "drift",
        "static"
      ],
      "default": "push_in",
      "hint": "push_in: Slow zoom in (1.00 → 1.08); pull_out: Slow zoom out (1.08 → 1.00); pan_left: Slow pan towards the left; pan_right: Slow pan towards the right; drift: Slow zoom with a slight rotation; static: No movement"
    },
    {
      "path": "animations.image_entry",
      "type": "animation",
      "required": false,
      "fills": "background (first 12 frames)",
      "values": [
        "fade",
        "blur_in",
        "wipe",
        "cut"
      ],
      "default": "fade",
      "hint": "fade: Fades in; blur_in: Sharpens from a blur; wipe: Revealed left to right; cut: No transition"
    },
    {
      "path": "animations.exit",
      "type": "animation",
      "required": false,
      "fills": "all foreground content",
      "values": [
        "fade_up",
        "fade",
        "slide_down",
        "scale_down",
        "cut"
      ],
      "default": "fade_up",
      "hint": "fade_up: Fades out while moving up; fade: Fades out; slide_down: Moves down while fading out; scale_down: Shrinks slightly while fading out; cut: Disappears instantly at the cut"
    },
    {
      "path": "cue_times",
      "type": "cues",
      "required": false,
      "fills": "When elements appear: heading → event 1 → event 2 → event 3 → event 4 → event 5 → event 6 → event 7 → event 8 → source",
      "limits": "seconds from the template start, increasing; First cue = heading (if present), then one cue per event (when the narrator reaches that date), then source."
    }
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TL-02 Timeline",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 3,
        "maxLength": 50,
        "description": "Heading above the timeline. 1–10 words, longest word 18 letters. \"The UPI story\"."
      },
      "source": {
        "type": "string",
        "minLength": 3,
        "maxLength": 60,
        "description": "Source line under the timeline. 1–10 words, longest word 18 letters."
      },
      "events": {
        "type": "array",
        "minItems": 3,
        "maxItems": 8,
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "description": "Date above the title. 1–4 words, longest word 12 letters. \"2016\", \"Aug 2016\", \"15 Aug 1947\"."
            },
            "title": {
              "type": "string",
              "minLength": 2,
              "maxLength": 35,
              "description": "Event title. 1–6 words, longest word 14 letters. What happened, in a few words."
            },
            "desc": {
              "type": "string",
              "minLength": 5,
              "maxLength": 70,
              "description": "Detail under the title. 2–12 words, longest word 14 letters. One short line of detail."
            },
            "milestone": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1,
              "description": "1 = bigger filled accent node and accent-coloured title. Raw number, no units or commas."
            },
            "icon": {
              "type": "string",
              "description": "Lucide icon name (kebab-case). Optional; fallback dot."
            },
            "image_url": {
              "type": "string",
              "format": "uri",
              "description": "Picture inside the event node (circle)"
            }
          },
          "required": [
            "date",
            "title"
          ],
          "additionalProperties": false
        },
        "description": "Events in time order"
      },
      "image_url": {
        "type": "string",
        "format": "uri",
        "description": "Full-bleed background (used when background = \"image\")"
      },
      "orientation": {
        "type": "string",
        "enum": [
          "horizontal",
          "vertical"
        ],
        "default": "horizontal",
        "description": "Track across the screen (labels alternate above / below), or down the left side"
      },
      "focus": {
        "type": "string",
        "enum": [
          "off",
          "on"
        ],
        "default": "off",
        "description": "Dim earlier events while a new one appears; everything brightens for the hold"
      },
      "background": {
        "type": "string",
        "enum": [
          "theme",
          "image",
          "transparent"
        ],
        "default": "theme",
        "description": "theme gradient, image_url, or transparent over footage"
      },
      "background_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background (gradient start, or solid) (same as style.background_color; wins over it)"
      },
      "background_2_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background gradient end (set equal to background for a solid colour) (same as style.background_2_color; wins over it)"
      },
      "style": {
        "type": "object",
        "additionalProperties": false,
        "description": "Fonts and colours. Omit any key to use the default.",
        "properties": {
          "heading_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
              "roboto_slab",
              "lora",
              "baloo_2",
              "mukta",
              "hind",
              "kalam"
            ],
            "default": "poppins",
