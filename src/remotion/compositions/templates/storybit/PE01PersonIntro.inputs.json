{
  "template": "PE-01",
  "name": "Person Intro Card",
  "animation_type": "pe_person_intro",
  "pick_when": "The first time an important person is named: who they are, in one card.",
  "placement": "both",
  "frame": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 100,
    "safe_box": [
      1720,
      880
    ]
  },
  "duration": {
    "frames": [
      90,
      240
    ],
    "seconds": [
      3,
      8
    ],
    "default_frames": 120,
    "note": "Length comes from the voice beat (clock.durationInFrames), not from props."
  },
  "rules": [
    "Stay within every limit below; longer text is shortened at a word boundary, too-short or missing required fields are errors.",
    "Numbers are raw values (no commas, units or currency symbols) — the template formats and animates them.",
    "Only real, sourced facts, quotes and figures. Label invented example numbers as illustrative.",
    "Icons are Lucide names from the repository icon map; unknown names render as a circle."
  ],
  "inputs": [
    {
      "path": "kicker",
      "type": "text",
      "required": false,
      "fills": "Small label above the name",
      "limits": "2–24 chars · 1–4 words · longest word 16 · max 1 line",
      "hint": "Small label above the name: \"Meet\", \"The founder\".",
      "example": "Meet"
    },
    {
      "path": "name",
      "type": "text",
      "required": true,
      "fills": "The name",
      "limits": "2–30 chars · 1–5 words · longest word 18 · max 2 lines",
      "hint": "Full name as it should appear.",
      "example": "Dr. A. P. J. Abdul Kalam"
    },
    {
      "path": "role",
      "type": "text",
      "required": false,
      "fills": "Role line under the name",
      "limits": "2–40 chars · 1–7 words · longest word 18 · max 2 lines",
      "hint": "Who they are: \"11th President of India\".",
      "example": "11th President of India"
    },
    {
      "path": "tagline",
      "type": "text",
      "required": false,
      "fills": "Line under the role",
      "limits": "5–70 chars · 2–12 words · longest word 18 · max 2 lines",
      "hint": "Why they matter, in one line.",
      "example": "Led India’s missile programme before becoming President"
    },
    {
      "path": "image_url",
      "type": "image",
      "required": false,
      "fills": "Full-bleed background (used when background = \"image\")",
      "limits": "https URL or asset URL"
    },
    {
      "path": "portrait_url",
      "type": "image",
      "required": false,
      "fills": "Photo of the person — required for the portrait_left / portrait_right / full_bleed layouts",
      "limits": "https URL or asset URL"
    },
    {
      "path": "layout",
      "type": "choice",
      "required": false,
      "fills": "auto = portrait_left when a portrait is given, else text_only · full_bleed puts the portrait over one half of the frame",
      "values": [
        "auto",
        "portrait_left",
        "portrait_right",
        "full_bleed",
        "text_only"
      ],
      "default": "auto"
    },
    {
      "path": "portrait_shape",
      "type": "choice",
      "required": false,
      "fills": "Shape of the portrait (left / right layouts)",
      "values": [
        "circle",
        "rounded"
      ],
      "default": "circle"
    },
    {
      "path": "align",
      "type": "choice",
      "required": false,
      "fills": "Text alignment in text_only",
      "values": [
        "left",
        "center"
      ],
      "default": "left"
    },
    {
      "path": "background",
      "type": "choice",
      "required": false,
      "fills": "theme gradient, image_url, or transparent over footage",
      "values": [
        "theme",
        "image",
        "transparent"
      ],
      "default": "theme"
    },
    {
      "path": "style.heading_font",
      "type": "choice",
      "required": false,
      "fills": "Font for bold text (weight ≥ 700: titles, numbers, headings)",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins"
    },
    {
      "path": "style.body_font",
      "type": "choice",
      "required": false,
      "fills": "Font for all other text",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins (or the heading font)"
    },
    {
      "path": "style.background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "style.background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "style.scrim_color",
      "type": "color",
      "required": false,
      "fills": "Dark overlay behind text on images and footage",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#080A1C"
    },
    {
      "path": "style.text_color",
      "type": "color",
      "required": false,
      "fills": "Main text (titles, labels, numbers)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#FFF6E6"
    },
    {
      "path": "style.muted_color",
      "type": "color",
      "required": false,
      "fills": "Secondary text (subtitles, descriptions, context)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#C9CDE8"
    },
    {
      "path": "style.accent_color",
      "type": "color",
      "required": false,
      "fills": "Accent lines, highlights, kicker, units",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F5A524"
    },
    {
      "path": "background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid) — same as style.background_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour) — same as style.background_2_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "font_sizes.kicker",
      "type": "number",
      "required": false,
      "fills": "Font size of small label above the name (px, largest; shrinks only if it would not fit)",
      "limits": "22–30 px",
      "default": 30
    },
    {
      "path": "font_sizes.name",
      "type": "number",
      "required": false,
      "fills": "Font size of the name (px, largest; shrinks only if it would not fit)",
      "limits": "60–120 px",
      "default": 120
    },
    {
      "path": "font_sizes.role",
      "type": "number",
      "required": false,
      "fills": "Font size of role line under the name (px, largest; shrinks only if it would not fit)",
      "limits": "28–44 px",
      "default": 44
    },
    {
      "path": "font_sizes.tagline",
      "type": "number",
      "required": false,
      "fills": "Font size of line under the role (px, largest; shrinks only if it would not fit)",
      "limits": "24–34 px",
      "default": 34
    },
    {
      "path": "animations.portrait",
      "type": "animation",
      "required": false,
      "fills": "the portrait",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "pop",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.portrait_motion",
      "type": "animation",
      "required": false,
      "fills": "slow movement inside the portrait",
      "values": [
        "push_in",
        "pull_out",
        "pan_left",
        "pan_right",
        "drift",
        "static"
      ],
      "default": "push_in",
      "hint": "push_in: Slow zoom in (1.00 → 1.08); pull_out: Slow zoom out (1.08 → 1.00); pan_left: Slow pan towards the left; pan_right: Slow pan towards the right; drift: Slow zoom with a slight rotation; static: No movement"
    },
    {
      "path": "animations.kicker",
      "type": "animation",
      "required": false,
      "fills": "kicker",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "slide_left",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.name",
      "type": "animation",
      "required": false,
      "fills": "the name",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "rise",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.rule",
      "type": "animation",
      "required": false,
      "fills": "line under the name",
      "values": [
        "grow",
        "fade",
        "pop",
        "none"
      ],
      "default": "grow",
      "hint": "grow: Draws out from its start; fade: Fades in; pop: Pops in with a small overshoot; none: Appears instantly"
    },
    {
      "path": "animations.role",
      "type": "animation",
      "required": false,
      "fills": "role line",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "fade_up",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.tagline",
      "type": "animation",
      "required": false,
      "fills": "tagline",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "fade",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.image_motion",
      "type": "animation",
      "required": false,
      "fills": "background image (whole clip)",
      "values": [
        "push_in",
        "pull_out",
        "pan_left",
        "pan_right",
        "drift",
        "static"
      ],
      "default": "push_in",
      "hint": "push_in: Slow zoom in (1.00 → 1.08); pull_out: Slow zoom out (1.08 → 1.00); pan_left: Slow pan towards the left; pan_right: Slow pan towards the right; drift: Slow zoom with a slight rotation; static: No movement"
    },
    {
      "path": "animations.image_entry",
      "type": "animation",
      "required": false,
      "fills": "background (first 12 frames)",
      "values": [
        "fade",
        "blur_in",
        "wipe",
        "cut"
      ],
      "default": "fade",
      "hint": "fade: Fades in; blur_in: Sharpens from a blur; wipe: Revealed left to right; cut: No transition"
    },
    {
      "path": "animations.exit",
      "type": "animation",
      "required": false,
      "fills": "all foreground content",
      "values": [
        "fade_up",
        "fade",
        "slide_down",
        "scale_down",
        "cut"
      ],
      "default": "fade_up",
      "hint": "fade_up: Fades out while moving up; fade: Fades out; slide_down: Moves down while fading out; scale_down: Shrinks slightly while fading out; cut: Disappears instantly at the cut"
    },
    {
      "path": "cue_times",
      "type": "cues",
      "required": false,
      "fills": "When elements appear: name → role → tagline",
      "limits": "seconds from the template start, increasing; name → role → tagline. Missing elements are skipped."
    }
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "PE-01 Person Intro Card",
    "type": "object",
