      "font_sizes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Largest font size per element in px. The template still shrinks text that would not fit.",
        "properties": {
          "notifications.app": {
            "type": "number",
            "minimum": 18,
            "maximum": 24,
            "default": 24,
