  },
  "example": {
    "subject": "The Example Bank Fraud",
    "case_no": "Case No. 2018/14",
    "fields": [
      {
        "label": "Accused",
        "value": "Replace with the real name"
      },
      {
        "label": "Amount",
        "value": "₹13,000 crore (illustrative)"
      },
      {
        "label": "Filed by",
        "value": "Replace with the agency"
      },
      {
        "label": "Status",
        "value": "Trial ongoing"
      }
    ],
    "stamp": "CONFIDENTIAL",
    "background": "theme"
  }
}
