              "none"
            ],
            "default": "pop",
            "description": "rubber stamp"
          },
          "image_motion": {
            "type": "string",
            "enum": [
              "push_in",
              "pull_out",
              "pan_left",
              "pan_right",
              "drift",
              "static"
            ],
