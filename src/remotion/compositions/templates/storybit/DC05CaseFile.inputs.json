      },
      "font_sizes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Largest font size per element in px. The template still shrinks text that would not fit.",
        "properties": {
          "subject": {
            "type": "number",
            "minimum": 34,
            "maximum": 56,
            "default": 56,
            "description": "Big name at the top of the page"
          },
          "case_no": {
            "type": "number",
            "minimum": 18,
