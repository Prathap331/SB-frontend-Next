      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "items": {
          "type": "object",
          "properties": {
            "publication": {
              "type": "string",
              "minLength": 2,
              "maxLength": 30,
              "description": "Publication name. 1–5 words, longest word 18 letters. Newspaper / site name as printed."
            },
            "headline": {
              "type": "string",
              "minLength": 10,
              "maxLength": 100,
              "description": "Headline. 3–18 words, longest word 18 letters. The real headline, word for word."
            },
            "date": {
              "type": "string",
              "minLength": 2,
              "maxLength": 20,
              "description": "Publication date. 1–4 words, longest word 12 letters. \"12 March 2025\"."
            },
            "image_url": {
              "type": "string",
              "format": "uri",
              "description": "Article picture (left of the headline)"
            }
          },
          "required": [
            "publication",
            "headline"
          ],
          "additionalProperties": false
        },
        "description": "Headlines, newest first (the band look shows the first one)"
      },
      "image_url": {
        "type": "string",
