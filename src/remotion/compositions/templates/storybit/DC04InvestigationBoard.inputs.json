{
  "template": "DC-04",
  "name": "Investigation Board",
  "animation_type": "dc_investigation_board",
  "pick_when": "Showing how people, companies, places or events are connected in a scam, crime or scandal.",
  "placement": "full",
  "frame": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 100,
    "safe_box": [
      1720,
      880
    ]
  },
  "duration": {
    "frames": [
      90,
      240
    ],
    "seconds": [
      3,
      8
    ],
    "default_frames": 210,
    "note": "Length comes from the voice beat (clock.durationInFrames), not from props."
  },
  "rules": [
    "Stay within every limit below; longer text is shortened at a word boundary, too-short or missing required fields are errors.",
    "Numbers are raw values (no commas, units or currency symbols) — the template formats and animates them.",
    "Only real, sourced facts, quotes and figures. Label invented example numbers as illustrative.",
    "Icons are Lucide names from the repository icon map; unknown names render as a circle."
  ],
  "inputs": [
    {
      "path": "title",
      "type": "text",
      "required": false,
      "fills": "Heading above the board",
      "limits": "3–40 chars · 1–8 words · longest word 18 · max 1 line",
      "example": "Follow the money"
    },
    {
      "path": "items[]",
      "type": "list",
      "required": true,
      "fills": "Pinned cards, in reveal order",
      "limits": "3–6 items"
    },
    {
      "path": "items[].label",
      "type": "text",
      "required": true,
      "fills": "Name under the photo",
      "limits": "2–24 chars · 1–4 words · longest word 16 · max 1 line",
      "hint": "Name of the person / company / place."
    },
    {
      "path": "items[].sub",
      "type": "text",
      "required": false,
      "fills": "Line under the name",
      "limits": "2–30 chars · 1–5 words · longest word 16 · max 1 line",
      "hint": "Role: \"Promoter\", \"Shell company\"."
    },
    {
      "path": "items[].focus",
      "type": "number",
      "required": false,
      "fills": "1 = the key card (red frame)",
      "limits": "integer · ≥ 0 · ≤ 1"
    },
    {
      "path": "items[].icon",
      "type": "icon",
      "required": false,
      "fills": "Card icon",
      "limits": "Lucide icon name",
      "fallback": "user (when there is no picture)"
    },
    {
      "path": "items[].image_url",
      "type": "image",
      "required": false,
      "fills": "Photo on the card (face, building, logo, document)",
      "limits": "https URL or asset URL"
    },
    {
      "path": "links[]",
      "type": "list",
      "required": false,
      "fills": "Red strings between cards, in reveal order",
      "limits": "up to 6"
    },
    {
      "path": "links[].from",
      "type": "number",
      "required": true,
      "fills": "Card number the string starts at (1 = first card)",
      "limits": "1–6"
    },
    {
      "path": "links[].to",
      "type": "number",
      "required": true,
      "fills": "Card number the string ends at",
      "limits": "1–6"
    },
    {
      "path": "links[].label",
      "type": "text",
      "required": false,
      "fills": "Words on the string (\"paid ₹40 Cr\", \"brother\")",
      "limits": "2–18 chars · 1–3 words"
    },
    {
      "path": "image_url",
      "type": "image",
      "required": false,
      "fills": "Full-bleed background (used when background = \"image\")",
      "limits": "https URL or asset URL"
    },
    {
      "path": "board",
      "type": "choice",
      "required": false,
      "fills": "Cork board or dark board",
      "values": [
        "cork",
        "dark"
      ],
      "default": "cork"
    },
    {
      "path": "background",
      "type": "choice",
      "required": false,
      "fills": "Behind the board",
      "values": [
        "theme",
        "image",
        "transparent"
      ],
      "default": "theme"
    },
    {
      "path": "style.heading_font",
      "type": "choice",
      "required": false,
      "fills": "Font for bold text (weight ≥ 700: titles, numbers, headings)",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins"
    },
    {
      "path": "style.body_font",
      "type": "choice",
      "required": false,
      "fills": "Font for all other text",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins (or the heading font)"
    },
    {
      "path": "style.background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "style.background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "style.scrim_color",
      "type": "color",
      "required": false,
      "fills": "Dark overlay behind text on images and footage",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#080A1C"
    },
    {
      "path": "style.text_color",
      "type": "color",
      "required": false,
      "fills": "Main text (titles, labels, numbers)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#FFF6E6"
    },
    {
      "path": "style.muted_color",
      "type": "color",
      "required": false,
      "fills": "Secondary text (subtitles, descriptions, context)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#C9CDE8"
    },
    {
      "path": "style.accent_color",
      "type": "color",
      "required": false,
      "fills": "Accent lines, highlights, kicker, units",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F5A524"
    },
    {
      "path": "style.negative_color",
      "type": "color",
      "required": false,
      "fills": "Bad change (down arrows, losses)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F87171"
    },
    {
      "path": "background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid) — same as style.background_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour) — same as style.background_2_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "font_sizes.title",
      "type": "number",
      "required": false,
      "fills": "Font size of heading above the board (px, largest; shrinks only if it would not fit)",
      "limits": "36–52 px",
      "default": 52
    },
    {
      "path": "font_sizes.items.label",
      "type": "number",
      "required": false,
      "fills": "Font size of name under the photo (px, largest; shrinks only if it would not fit)",
      "limits": "18–30 px",
      "default": 30
    },
    {
      "path": "font_sizes.items.sub",
      "type": "number",
      "required": false,
      "fills": "Font size of line under the name (px, largest; shrinks only if it would not fit)",
      "limits": "14–20 px",
      "default": 20
    },
    {
      "path": "animations.title",
      "type": "animation",
      "required": false,
      "fills": "heading",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "rise",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.cards",
      "type": "animation",
      "required": false,
      "fills": "each pinned card",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "pop",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.strings",
      "type": "animation",
      "required": false,
      "fills": "each red string",
      "values": [
        "grow",
        "fade",
        "pop",
        "none"
      ],
      "default": "grow",
      "hint": "grow: Draws out from its start; fade: Fades in; pop: Pops in with a small overshoot; none: Appears instantly"
    },
    {
      "path": "animations.link_labels",
      "type": "animation",
      "required": false,
      "fills": "words on each string",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "pop",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.image_motion",
      "type": "animation",
      "required": false,
      "fills": "background image",
      "values": [
        "push_in",
        "pull_out",
        "pan_left",
        "pan_right",
        "drift",
        "static"
      ],
      "default": "push_in",
      "hint": "push_in: Slow zoom in (1.00 → 1.08); pull_out: Slow zoom out (1.08 → 1.00); pan_left: Slow pan towards the left; pan_right: Slow pan towards the right; drift: Slow zoom with a slight rotation; static: No movement"
    },
    {
      "path": "animations.image_entry",
      "type": "animation",
      "required": false,
      "fills": "background (first 12 frames)",
      "values": [
        "fade",
        "blur_in",
        "wipe",
        "cut"
      ],
      "default": "fade",
      "hint": "fade: Fades in; blur_in: Sharpens from a blur; wipe: Revealed left to right; cut: No transition"
    },
    {
      "path": "animations.exit",
      "type": "animation",
      "required": false,
      "fills": "the board",
      "values": [
        "fade_up",
        "fade",
        "slide_down",
        "scale_down",
        "cut"
      ],
      "default": "fade",
      "hint": "fade_up: Fades out while moving up; fade: Fades out; slide_down: Moves down while fading out; scale_down: Shrinks slightly while fading out; cut: Disappears instantly at the cut"
    },
    {
      "path": "cue_times",
      "type": "cues",
      "required": false,
      "fills": "When elements appear: heading → card 1 → card 2 → card 3 → card 4 → card 5 → card 6 → string 1 → string 2 → string 3 → string 4 → string 5 → string 6",
      "limits": "seconds from the template start, increasing; Fixed slots: heading → card 1…6 → string 1…6. Send null for slots you do not use."
    }
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "DC-04 Investigation Board",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 3,
        "maxLength": 40,
        "description": "Heading above the board. 1–8 words, longest word 18 letters."
      },
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 6,
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 2,
              "maxLength": 24,
              "description": "Name under the photo. 1–4 words, longest word 16 letters. Name of the person / company / place."
            },
            "sub": {
              "type": "string",
              "minLength": 2,
              "maxLength": 30,
              "description": "Line under the name. 1–5 words, longest word 16 letters. Role: \"Promoter\", \"Shell company\"."
            },
            "focus": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1,
              "description": "1 = the key card (red frame). Raw number, no units or commas."
            },
            "icon": {
              "type": "string",
              "description": "Lucide icon name (kebab-case). Optional; fallback user (when there is no picture)."
            },
            "image_url": {
              "type": "string",
              "format": "uri",
              "description": "Photo on the card (face, building, logo, document)"
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        "description": "Pinned cards, in reveal order"
      },
      "links": {
        "type": "array",
        "maxItems": 6,
        "description": "Strings between cards (1-based card numbers).",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "to": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "label": {
              "type": "string",
              "minLength": 2,
              "maxLength": 18
            }
          }
        }
      },
      "image_url": {
        "type": "string",
        "format": "uri",
        "description": "Full-bleed background (used when background = \"image\")"
      },
      "board": {
        "type": "string",
        "enum": [
