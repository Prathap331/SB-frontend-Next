        "description": "Full-bleed background (used when background = \"image\")"
      },
      "total": {
        "type": "string",
        "enum": [
          "10",
          "20",
          "50",
          "100"
        ],
        "default": "10",
        "description": "Size of the grid (use 10 for \"x in 10\", 100 for percentages)"
      },
      "figure_style": {
        "type": "string",
        "enum": [
          "ratio",
          "percent"
        ],
        "default": "ratio",
        "description": "Default figure: \"1 in 5\" (reduced ratio) or \"20%\""
      },
      "background": {
        "type": "string",
        "enum": [
          "theme",
          "image",
          "transparent"
        ],
        "default": "theme",
