      "cue_times": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maxItems": 4,
        "description": "Seconds from the template start when each element appears, in order: heading, chart, centre number, source. heading → chart starts sweeping → centre number → source. Missing elements are skipped. Compute as (spoken word time − beat start time) from WhisperX."
      }
    },
    "required": [
      "slices"
    ],
    "additionalProperties": false
