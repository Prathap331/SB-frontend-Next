          },
          "legend": {
            "type": "string",
            "enum": [
              "pop",
              "slide_up",
              "slide_left",
              "fade",
              "none"
            ],
            "default": "slide_left",
            "description": "each legend row"
          },
          "highlight": {
            "type": "string",
            "enum": [
              "grow",
              "fade",
              "pop",
              "none"
            ],
            "default": "pop",
            "description": "highlighted slice moving out"
          },
          "center": {
            "type": "string",
            "enum": [
              "count_up",
              "count_up_pop",
              "rise",
              "fade_up",
              "scale_in",
              "blur_in",
              "none"
            ],
            "default": "count_up",
            "description": "number in the donut centre"
          },
          "source": {
            "type": "string",
            "enum": [
              "rise",
              "fade_up",
              "fade",
              "blur_in",
              "scale_in",
              "slam",
              "slide_left",
              "slide_right",
              "none",
              "word_fade",
              "word_pop",
              "typewriter",
              "letter_rise"
            ],
            "default": "fade",
            "description": "source line"
          },
          "image_motion": {
            "type": "string",
            "enum": [
              "push_in",
              "pull_out",
              "pan_left",
              "pan_right",
              "drift",
              "static"
