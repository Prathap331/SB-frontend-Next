      "font_sizes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Largest font size per element in px. The template still shrinks text that would not fit.",
        "properties": {
          "title": {
            "type": "number",
            "minimum": 40,
            "maximum": 60,
            "default": 60,
            "description": "Heading above the chart"
          },
          "center_label": {
            "type": "number",
            "minimum": 18,
            "maximum": 30,
            "default": 30,
            "description": "Text under the number in the donut centre"
          },
          "source": {
            "type": "number",
            "minimum": 18,
            "maximum": 24,
            "default": 24,
            "description": "Source line under the chart"
          },
          "slices.label": {
            "type": "number",
            "minimum": 24,
            "maximum": 40,
            "default": 40,
            "description": "Legend label"
          },
          "center": {
            "type": "number",
            "minimum": 48,
            "maximum": 140,
            "default": 140,
            "description": "Number in the donut centre"
          }
        }
      },
      "animations": {
        "type": "object",
        "additionalProperties": false,
        "description": "Animation preset per element. Omit a key to use its default.",
        "properties": {
          "title": {
            "type": "string",
            "enum": [
              "rise",
              "fade_up",
              "fade",
              "blur_in",
              "scale_in",
              "slam",
              "slide_left",
              "slide_right",
              "none",
              "word_fade",
              "word_pop",
              "typewriter",
              "letter_rise"
            ],
            "default": "rise",
            "description": "heading"
          },
          "slices": {
            "type": "string",
            "enum": [
              "grow",
              "fade",
              "pop",
              "none"
            ],
            "default": "grow",
