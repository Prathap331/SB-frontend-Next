{
  "template": "NV-03",
  "name": "Progress Tracker",
  "animation_type": "nv_progress_tracker",
  "pick_when": "At the start of each section of a long video: shows the sections and where we are now.",
  "placement": "overlay",
  "frame": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 100,
    "safe_box": [
      1720,
      880
    ]
  },
  "duration": {
    "frames": [
      45,
      240
    ],
    "seconds": [
      1.5,
      8
    ],
    "default_frames": 120,
    "note": "Length comes from the voice beat (clock.durationInFrames), not from props."
  },
  "rules": [
    "Stay within every limit below; longer text is shortened at a word boundary, too-short or missing required fields are errors.",
    "Numbers are raw values (no commas, units or currency symbols) — the template formats and animates them.",
    "Only real, sourced facts, quotes and figures. Label invented example numbers as illustrative.",
    "Icons are Lucide names from the repository icon map; unknown names render as a circle."
  ],
  "inputs": [
    {
      "path": "current",
      "type": "number",
      "required": true,
      "fills": "Number of the section now starting (1 = first)",
      "limits": "integer · ≥ 1 · ≤ 8",
      "example": 2
    },
    {
      "path": "sections[]",
      "type": "list",
      "required": true,
      "fills": "Sections of the video in order",
      "limits": "2–8 items"
    },
    {
      "path": "sections[].label",
      "type": "text",
      "required": true,
      "fills": "Section name",
      "limits": "1–22 chars · 1–4 words · longest word 16 · max 1 line"
    },
    {
      "path": "position",
      "type": "choice",
      "required": false,
      "fills": "Top or bottom of the safe area",
      "values": [
        "top",
        "bottom"
      ],
      "default": "top"
    },
    {
      "path": "look",
      "type": "choice",
      "required": false,
      "fills": "segments: a pill per section · line: one thin line with dots and names under it",
      "values": [
        "segments",
        "line"
      ],
      "default": "segments"
    },
    {
      "path": "style.heading_font",
      "type": "choice",
      "required": false,
      "fills": "Font for bold text (weight ≥ 700: titles, numbers, headings)",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins"
    },
    {
      "path": "style.body_font",
      "type": "choice",
      "required": false,
      "fills": "Font for all other text",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins (or the heading font)"
    },
    {
      "path": "style.background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "style.background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "style.scrim_color",
      "type": "color",
      "required": false,
      "fills": "Dark overlay behind text on images and footage",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#080A1C"
    },
    {
      "path": "style.text_color",
      "type": "color",
      "required": false,
      "fills": "Main text (titles, labels, numbers)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#FFF6E6"
    },
    {
      "path": "style.muted_color",
      "type": "color",
      "required": false,
      "fills": "Secondary text (subtitles, descriptions, context)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#C9CDE8"
    },
    {
      "path": "style.accent_color",
      "type": "color",
      "required": false,
      "fills": "Accent lines, highlights, kicker, units",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F5A524"
    },
    {
      "path": "background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid) — same as style.background_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour) — same as style.background_2_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "font_sizes.sections.label",
      "type": "number",
      "required": false,
      "fills": "Font size of section name (px, largest; shrinks only if it would not fit)",
      "limits": "14–26 px",
      "default": 26
    },
    {
      "path": "animations.bar",
      "type": "animation",
      "required": false,
      "fills": "the tracker",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "fade",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.fill",
      "type": "animation",
      "required": false,
      "fills": "the current section filling up",
      "values": [
        "grow",
        "fade",
        "pop",
        "none"
      ],
      "default": "grow",
      "hint": "grow: Draws out from its start; fade: Fades in; pop: Pops in with a small overshoot; none: Appears instantly"
    },
    {
      "path": "animations.exit",
      "type": "animation",
      "required": false,
      "fills": "the tracker",
      "values": [
        "fade_up",
        "fade",
        "slide_down",
        "scale_down",
        "cut"
      ],
      "default": "fade",
      "hint": "fade_up: Fades out while moving up; fade: Fades out; slide_down: Moves down while fading out; scale_down: Shrinks slightly while fading out; cut: Disappears instantly at the cut"
    },
    {
      "path": "cue_times",
      "type": "cues",
      "required": false,
      "fills": "When elements appear: bar → fill",
      "limits": "seconds from the template start, increasing; bar → fill (the new section begins)."
    }
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "NV-03 Progress Tracker",
    "type": "object",
    "properties": {
      "current": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8,
        "description": "Number of the section now starting (1 = first). Raw number, no units or commas."
      },
      "sections": {
        "type": "array",
        "minItems": 2,
        "maxItems": 8,
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 22,
              "description": "Section name. 1–4 words, longest word 16 letters."
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        "description": "Sections of the video in order"
      },
      "position": {
        "type": "string",
        "enum": [
          "top",
          "bottom"
        ],
        "default": "top",
        "description": "Top or bottom of the safe area"
      },
      "look": {
        "type": "string",
        "enum": [
          "segments",
          "line"
        ],
        "default": "segments",
        "description": "segments: a pill per section · line: one thin line with dots and names under it"
      },
      "background_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background (gradient start, or solid) (same as style.background_color; wins over it)"
      },
      "background_2_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background gradient end (set equal to background for a solid colour) (same as style.background_2_color; wins over it)"
      },
      "style": {
        "type": "object",
        "additionalProperties": false,
        "description": "Fonts and colours. Omit any key to use the default.",
        "properties": {
          "heading_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
              "roboto_slab",
              "lora",
              "baloo_2",
              "mukta",
              "hind",
              "kalam"
            ],
            "default": "poppins",
            "description": "Font for weight ≥ 700 text"
          },
          "body_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
              "roboto_slab",
              "lora",
              "baloo_2",
              "mukta",
              "hind",
              "kalam"
            ],
            "description": "Font for other text"
          },
          "background_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Theme background (gradient start, or solid)",
            "default": "#141A45"
          },
          "background_2_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Theme background gradient end (set equal to background for a solid colour)",
            "default": "#0C1030"
          },
          "scrim_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Dark overlay behind text on images and footage",
            "default": "#080A1C"
          },
          "text_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Main text (titles, labels, numbers)",
            "default": "#FFF6E6"
          },
          "muted_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Secondary text (subtitles, descriptions, context)",
            "default": "#C9CDE8"
          },
          "accent_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
            "description": "Accent lines, highlights, kicker, units",
            "default": "#F5A524"
          }
        }
      },
      "font_sizes": {
        "type": "object",
        "additionalProperties": false,
        "description": "Largest font size per element in px. The template still shrinks text that would not fit.",
        "properties": {
          "sections.label": {
            "type": "number",
            "minimum": 14,
            "maximum": 26,
            "default": 26,
            "description": "Section name"
          }
        }
      },
      "animations": {
        "type": "object",
        "additionalProperties": false,
        "description": "Animation preset per element. Omit a key to use its default.",
        "properties": {
          "bar": {
            "type": "string",
            "enum": [
              "pop",
              "slide_up",
              "slide_left",
              "fade",
              "none"
            ],
            "default": "fade",
            "description": "the tracker"
          },
          "fill": {
            "type": "string",
            "enum": [
              "grow",
              "fade",
              "pop",
              "none"
            ],
            "default": "grow",
            "description": "the current section filling up"
          },
          "exit": {
            "type": "string",
            "enum": [
              "fade_up",
              "fade",
              "slide_down",
              "scale_down",
              "cut"
            ],
            "default": "fade",
            "description": "the tracker"
          }
        }
      },
      "cue_times": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maxItems": 2,
        "description": "Seconds from the template start when each element appears, in order: bar, fill. bar → fill (the new section begins). Compute as (spoken word time − beat start time) from WhisperX."
      }
    },
    "required": [
      "current",
      "sections"
    ],
    "additionalProperties": false
  },
  "example": {
    "sections": [
      {
        "label": "The idea"
      },
      {
        "label": "The rise"
      },
      {
        "label": "The crash"
      },
      {
        "label": "What now"
      }
    ],
    "current": 3,
    "position": "top",
    "look": "segments"
  }
}
