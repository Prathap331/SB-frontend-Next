      },
      "elements": {
        "type": "object",
        "description": "Editor edits per element id (see element_manifest.json): position, style, visibility and animation.",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visible": {
              "type": "boolean"
            },
            "offset_x": {
              "type": "number"
            },
            "offset_y": {
              "type": "number"
