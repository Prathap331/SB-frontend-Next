            },
            "border": {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "width": {
                  "type": "number"
                },
                "radius": {
                  "type": "number"
                }
              }
            },
            "shadow": {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "blur": {
                  "type": "number"
                },
                "offset_x": {
                  "type": "number"
                },
                "offset_y": {
                  "type": "number"
                }
              }
            },
            "blend_mode": {
              "enum": [
                "normal",
                "multiply",
                "screen",
                "overlay",
                "lighten",
                "darken"
              ]
            },
            "animation": {
