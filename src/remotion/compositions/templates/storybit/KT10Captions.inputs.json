            },
            "letter_spacing": {
              "type": "number"
            },
            "text_case": {
              "enum": [
                "none",
                "upper",
                "lower",
                "title"
              ]
            },
            "text_align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "italic": {
              "type": "boolean"
            },
            "underline": {
              "type": "boolean"
            },
            "fill": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
            },
            "border": {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "width": {
                  "type": "number"
                },
                "radius": {
                  "type": "number"
                }
              }
            },
            "shadow": {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "blur": {
                  "type": "number"
                },
