{
  "template": "DV-14",
  "name": "Leaderboard",
  "animation_type": "dv_leaderboard",
  "pick_when": "A top-N ranking: richest, biggest, most populous, most-watched — with or without values.",
  "placement": "both",
  "frame": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 100,
    "safe_box": [
      1720,
      880
    ]
  },
  "duration": {
    "frames": [
      90,
      240
    ],
    "seconds": [
      3,
      8
    ],
    "default_frames": 210,
    "note": "Length comes from the voice beat (clock.durationInFrames), not from props."
  },
  "rules": [
    "Stay within every limit below; longer text is shortened at a word boundary, too-short or missing required fields are errors.",
    "Numbers are raw values (no commas, units or currency symbols) — the template formats and animates them.",
    "Only real, sourced facts, quotes and figures. Label invented example numbers as illustrative.",
    "Icons are Lucide names from the repository icon map; unknown names render as a circle."
  ],
  "inputs": [
    {
      "path": "title",
      "type": "text",
      "required": false,
      "fills": "Heading above the list",
      "limits": "3–50 chars · 1–10 words · longest word 18 · max 1 line",
      "hint": "\"Top 5 richest Indians (illustrative)\".",
      "example": "Most-used UPI apps (illustrative)"
    },
    {
      "path": "prefix",
      "type": "text",
      "required": false,
      "fills": "Symbol before every value",
      "limits": "1–3 chars · 1–1 words · longest word 3 · max 1 line"
    },
    {
      "path": "unit",
      "type": "text",
      "required": false,
      "fills": "Unit after every value",
      "limits": "1–8 chars · 1–1 words · longest word 8 · max 1 line"
    },
    {
      "path": "source",
      "type": "text",
      "required": false,
      "fills": "Source line under the list",
      "limits": "3–60 chars · 1–10 words · longest word 18 · max 1 line",
      "hint": "\"Source: Forbes, 2025\"."
    },
    {
      "path": "items[]",
      "type": "list",
      "required": true,
      "fills": "Ranked rows, #1 first",
      "limits": "3–10 items"
    },
    {
      "path": "items[].label",
      "type": "text",
      "required": true,
      "fills": "Row name",
      "limits": "1–28 chars · 1–5 words · longest word 16 · max 1 line",
      "hint": "Who / what is ranked."
    },
    {
      "path": "items[].sub",
      "type": "text",
      "required": false,
      "fills": "Line under the name",
      "limits": "2–40 chars · 1–7 words · longest word 16 · max 1 line",
      "hint": "Small detail: company, city, category."
    },
    {
      "path": "items[].value",
      "type": "number",
      "required": false,
      "fills": "Raw value shown on the right (and as a bar)",
      "limits": "number"
    },
    {
      "path": "items[].icon",
      "type": "icon",
      "required": false,
      "fills": "Row icon",
      "limits": "Lucide icon name",
      "fallback": "none"
    },
    {
      "path": "items[].image_url",
      "type": "image",
      "required": false,
      "fills": "Circle picture next to the rank (logo, face, flag)",
      "limits": "https URL or asset URL"
    },
    {
      "path": "items[].bg_color",
      "type": "color",
      "required": false,
      "fills": "Background colour of this row (to highlight it)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "theme card colour"
    },
    {
      "path": "image_url",
      "type": "image",
      "required": false,
      "fills": "Full-bleed background (used when background = \"image\")",
      "limits": "https URL or asset URL"
    },
    {
      "path": "order",
      "type": "choice",
      "required": false,
      "fills": "Rows appear #1 first, or as a countdown ending on #1",
      "values": [
        "top_down",
        "countdown"
      ],
      "default": "top_down"
    },
    {
      "path": "sort",
      "type": "choice",
      "required": false,
      "fills": "Keep the given ranking, or rank by value (desc = biggest is #1)",
      "values": [
        "as_given",
        "desc",
        "asc"
      ],
      "default": "as_given"
    },
    {
      "path": "bars",
      "type": "choice",
      "required": false,
      "fills": "Bar sized by value behind each row (auto = on when every row has a value)",
      "values": [
        "auto",
        "on",
        "off"
      ],
      "default": "auto"
    },
    {
      "path": "rank_style",
      "type": "choice",
      "required": false,
      "fills": "Plain numbers, or gold / silver / bronze badges for the top 3",
      "values": [
        "number",
        "medal"
      ],
      "default": "medal"
    },
    {
      "path": "highlight",
      "type": "choice",
      "required": false,
      "fills": "Accent outline on the #1 row",
      "values": [
        "first",
        "none"
      ],
      "default": "first"
    },
    {
      "path": "format",
      "type": "choice",
      "required": false,
      "fills": "indian_compact 4,200 Cr / 73.5 L · intl_compact 42B · indian_full 4,20,00,00,00,000 · intl_full 42,000,000,000 · plain 42000000000",
      "values": [
        "indian_compact",
        "intl_compact",
        "indian_full",
        "intl_full",
        "plain"
      ],
      "default": "indian_compact"
    },
    {
      "path": "decimals",
      "type": "choice",
      "required": false,
      "fills": "Decimal places shown",
      "values": [
        "auto",
        "0",
        "1",
        "2"
      ],
      "default": "auto"
    },
    {
      "path": "background",
      "type": "choice",
      "required": false,
      "fills": "theme gradient, image_url, or transparent over footage",
      "values": [
        "theme",
        "image",
        "transparent"
      ],
      "default": "theme"
    },
    {
      "path": "style.heading_font",
      "type": "choice",
      "required": false,
      "fills": "Font for bold text (weight ≥ 700: titles, numbers, headings)",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins"
    },
    {
      "path": "style.body_font",
      "type": "choice",
      "required": false,
      "fills": "Font for all other text",
      "values": [
        "poppins",
        "inter",
        "montserrat",
        "dm_sans",
        "space_grotesk",
        "oswald",
        "bebas_neue",
        "playfair_display",
        "roboto_slab",
        "lora",
        "baloo_2",
        "mukta",
        "hind",
        "kalam"
      ],
      "default": "poppins (or the heading font)"
    },
    {
      "path": "style.background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "style.background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "style.scrim_color",
      "type": "color",
      "required": false,
      "fills": "Dark overlay behind text on images and footage",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#080A1C"
    },
    {
      "path": "style.text_color",
      "type": "color",
      "required": false,
      "fills": "Main text (titles, labels, numbers)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#FFF6E6"
    },
    {
      "path": "style.muted_color",
      "type": "color",
      "required": false,
      "fills": "Secondary text (subtitles, descriptions, context)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#C9CDE8"
    },
    {
      "path": "style.accent_color",
      "type": "color",
      "required": false,
      "fills": "Accent lines, highlights, kicker, units",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#F5A524"
    },
    {
      "path": "style.icon_color",
      "type": "color",
      "required": false,
      "fills": "Icon strokes (default: accent)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.icon_bg_color",
      "type": "color",
      "required": false,
      "fills": "Circle behind icons (default: accent at 18%)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.card_color",
      "type": "color",
      "required": false,
      "fills": "Chip / card / step fill (default: translucent white, darker over footage)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.card_border_color",
      "type": "color",
      "required": false,
      "fills": "Chip / card outline (default: translucent white)",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "derived"
    },
    {
      "path": "style.on_accent_color",
      "type": "color",
      "required": false,
      "fills": "Icons and numbers drawn on accent-filled shapes",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_color",
      "type": "color",
      "required": false,
      "fills": "Theme background (gradient start, or solid) — same as style.background_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#141A45"
    },
    {
      "path": "background_2_color",
      "type": "color",
      "required": false,
      "fills": "Theme background gradient end (set equal to background for a solid colour) — same as style.background_2_color; used when background is \"theme\"",
      "limits": "hex #RRGGBB (or #RRGGBBAA)",
      "default": "#0C1030"
    },
    {
      "path": "font_sizes.title",
      "type": "number",
      "required": false,
      "fills": "Font size of heading above the list (px, largest; shrinks only if it would not fit)",
      "limits": "40–60 px",
      "default": 60
    },
    {
      "path": "font_sizes.source",
      "type": "number",
      "required": false,
      "fills": "Font size of source line under the list (px, largest; shrinks only if it would not fit)",
      "limits": "18–24 px",
      "default": 24
    },
    {
      "path": "font_sizes.items.label",
      "type": "number",
      "required": false,
      "fills": "Font size of row name (px, largest; shrinks only if it would not fit)",
      "limits": "20–44 px",
      "default": 44
    },
    {
      "path": "font_sizes.items.sub",
      "type": "number",
      "required": false,
      "fills": "Font size of line under the name (px, largest; shrinks only if it would not fit)",
      "limits": "16–26 px",
      "default": 26
    },
    {
      "path": "animations.title",
      "type": "animation",
      "required": false,
      "fills": "heading",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "rise",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.rows",
      "type": "animation",
      "required": false,
      "fills": "each row",
      "values": [
        "pop",
        "slide_up",
        "slide_left",
        "fade",
        "none"
      ],
      "default": "slide_left",
      "hint": "pop: Pops in with a small overshoot; slide_up: Slides up while fading in; slide_left: Slides in from the left; fade: Fades in; none: Appears instantly"
    },
    {
      "path": "animations.ranks",
      "type": "animation",
      "required": false,
      "fills": "rank badge of each row",
      "values": [
        "pop",
        "spin_in",
        "bounce",
        "fade",
        "wipe",
        "none"
      ],
      "default": "pop",
      "hint": "pop: Pops in with a small overshoot; spin_in: Spins in a quarter turn while growing; bounce: Drops in and bounces; fade: Fades in; wipe: Revealed left to right; none: Appears instantly"
    },
    {
      "path": "animations.media",
      "type": "animation",
      "required": false,
      "fills": "picture or icon of each row",
      "values": [
        "pop",
        "spin_in",
        "bounce",
        "fade",
        "wipe",
        "none"
      ],
      "default": "pop",
      "hint": "pop: Pops in with a small overshoot; spin_in: Spins in a quarter turn while growing; bounce: Drops in and bounces; fade: Fades in; wipe: Revealed left to right; none: Appears instantly"
    },
    {
      "path": "animations.bars",
      "type": "animation",
      "required": false,
      "fills": "value bar of each row",
      "values": [
        "grow",
        "fade",
        "pop",
        "none"
      ],
      "default": "grow",
      "hint": "grow: Draws out from its start; fade: Fades in; pop: Pops in with a small overshoot; none: Appears instantly"
    },
    {
      "path": "animations.values",
      "type": "animation",
      "required": false,
      "fills": "value of each row",
      "values": [
        "count_up",
        "count_up_pop",
        "rise",
        "fade_up",
        "scale_in",
        "blur_in",
        "none"
      ],
      "default": "count_up",
      "hint": "count_up: Counts up to the value; count_up_pop: Counts up, then pops when it lands; rise: Line rises out of a mask; fade_up: Fades in while moving up; scale_in: Grows from 85% while fading in; blur_in: Sharpens from a blur; none: Appears instantly"
    },
    {
      "path": "animations.source",
      "type": "animation",
      "required": false,
      "fills": "source line",
      "values": [
        "rise",
        "fade_up",
        "fade",
        "blur_in",
        "scale_in",
        "slam",
        "slide_left",
        "slide_right",
        "none",
        "word_fade",
        "word_pop",
        "typewriter",
        "letter_rise"
      ],
      "default": "fade",
      "hint": "rise: Line rises out of a mask; fade_up: Fades in while moving up; fade: Fades in; blur_in: Sharpens from a blur; scale_in: Grows from 85% while fading in; slam: Slams in from big to normal size with a bounce; slide_left: Slides in from the left; slide_right: Slides in from the right; none: Appears instantly; word_fade: Words fade up one after another; word_pop: Words pop in one after another; typewriter: Letters are typed out; letter_rise: Letters rise one after another"
    },
    {
      "path": "animations.image_motion",
      "type": "animation",
      "required": false,
      "fills": "background image (whole clip)",
      "values": [
        "push_in",
        "pull_out",
        "pan_left",
        "pan_right",
        "drift",
        "static"
      ],
      "default": "push_in",
      "hint": "push_in: Slow zoom in (1.00 → 1.08); pull_out: Slow zoom out (1.08 → 1.00); pan_left: Slow pan towards the left; pan_right: Slow pan towards the right; drift: Slow zoom with a slight rotation; static: No movement"
    },
    {
      "path": "animations.image_entry",
      "type": "animation",
      "required": false,
      "fills": "background (first 12 frames)",
      "values": [
        "fade",
        "blur_in",
        "wipe",
        "cut"
      ],
      "default": "fade",
      "hint": "fade: Fades in; blur_in: Sharpens from a blur; wipe: Revealed left to right; cut: No transition"
    },
    {
      "path": "animations.exit",
      "type": "animation",
      "required": false,
      "fills": "all foreground content",
      "values": [
        "fade_up",
        "fade",
        "slide_down",
        "scale_down",
        "cut"
      ],
      "default": "fade_up",
      "hint": "fade_up: Fades out while moving up; fade: Fades out; slide_down: Moves down while fading out; scale_down: Shrinks slightly while fading out; cut: Disappears instantly at the cut"
    },
    {
      "path": "cue_times",
      "type": "cues",
      "required": false,
      "fills": "When elements appear: heading → row revealed 1st → 2nd → 3rd → 4th → 5th → 6th → 7th → 8th → 9th → 10th → source",
      "limits": "seconds from the template start, increasing; First cue = heading (if present), then one cue per row in REVEAL order (countdown: the last rank is revealed first), then source."
    }
  ],
  "json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "DV-14 Leaderboard",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 3,
        "maxLength": 50,
        "description": "Heading above the list. 1–10 words, longest word 18 letters. \"Top 5 richest Indians (illustrative)\"."
      },
      "prefix": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3,
        "description": "Symbol before every value. 1–1 words, longest word 3 letters."
      },
      "unit": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8,
        "description": "Unit after every value. 1–1 words, longest word 8 letters."
      },
      "source": {
        "type": "string",
        "minLength": 3,
        "maxLength": 60,
        "description": "Source line under the list. 1–10 words, longest word 18 letters. \"Source: Forbes, 2025\"."
      },
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 10,
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 28,
              "description": "Row name. 1–5 words, longest word 16 letters. Who / what is ranked."
            },
            "sub": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40,
              "description": "Line under the name. 1–7 words, longest word 16 letters. Small detail: company, city, category."
            },
            "value": {
              "type": "number",
              "description": "Raw value shown on the right (and as a bar). Raw number, no units or commas."
            },
            "icon": {
              "type": "string",
              "description": "Lucide icon name (kebab-case). Optional; fallback none."
            },
            "image_url": {
              "type": "string",
              "format": "uri",
              "description": "Circle picture next to the rank (logo, face, flag)"
            },
            "bg_color": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
              "description": "Background colour of this row, hex e.g. #1E3A8A (optional — highlights it)"
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        "description": "Ranked rows, #1 first"
      },
      "image_url": {
        "type": "string",
        "format": "uri",
        "description": "Full-bleed background (used when background = \"image\")"
      },
      "order": {
        "type": "string",
        "enum": [
          "top_down",
          "countdown"
        ],
        "default": "top_down",
        "description": "Rows appear #1 first, or as a countdown ending on #1"
      },
      "sort": {
        "type": "string",
        "enum": [
          "as_given",
          "desc",
          "asc"
        ],
        "default": "as_given",
        "description": "Keep the given ranking, or rank by value (desc = biggest is #1)"
      },
      "bars": {
        "type": "string",
        "enum": [
          "auto",
          "on",
          "off"
        ],
        "default": "auto",
        "description": "Bar sized by value behind each row (auto = on when every row has a value)"
      },
      "rank_style": {
        "type": "string",
        "enum": [
          "number",
          "medal"
        ],
        "default": "medal",
        "description": "Plain numbers, or gold / silver / bronze badges for the top 3"
      },
      "highlight": {
        "type": "string",
        "enum": [
          "first",
          "none"
        ],
        "default": "first",
        "description": "Accent outline on the #1 row"
      },
      "format": {
        "type": "string",
        "enum": [
          "indian_compact",
          "intl_compact",
          "indian_full",
          "intl_full",
          "plain"
        ],
        "default": "indian_compact",
        "description": "indian_compact 4,200 Cr / 73.5 L · intl_compact 42B · indian_full 4,20,00,00,00,000 · intl_full 42,000,000,000 · plain 42000000000"
      },
      "decimals": {
        "type": "string",
        "enum": [
          "auto",
          "0",
          "1",
          "2"
        ],
        "default": "auto",
        "description": "Decimal places shown"
      },
      "background": {
        "type": "string",
        "enum": [
          "theme",
          "image",
          "transparent"
        ],
        "default": "theme",
        "description": "theme gradient, image_url, or transparent over footage"
      },
      "background_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background (gradient start, or solid) (same as style.background_color; wins over it)"
      },
      "background_2_color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
        "description": "Theme background gradient end (set equal to background for a solid colour) (same as style.background_2_color; wins over it)"
      },
      "style": {
        "type": "object",
        "additionalProperties": false,
        "description": "Fonts and colours. Omit any key to use the default.",
        "properties": {
          "heading_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
              "roboto_slab",
              "lora",
              "baloo_2",
              "mukta",
              "hind",
              "kalam"
            ],
            "default": "poppins",
            "description": "Font for weight ≥ 700 text"
          },
          "body_font": {
            "type": "string",
            "enum": [
              "poppins",
              "inter",
              "montserrat",
              "dm_sans",
              "space_grotesk",
              "oswald",
              "bebas_neue",
              "playfair_display",
